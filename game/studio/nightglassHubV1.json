  "dialogue": [
    {
      "lineId": "lumWelcome",
      "sceneId": "nightglassBarHub",
      "speakerId": "lum",
      "intentTag": "quest",
      "text": "Welcome to the Nightglass, Professor. Two shores. One moon. Neither remembers the same yesterday.",
      "choices": [
        {
          "choiceId": "askVesper",
          "label": "Ask about the other shore",
          "nextLineId": "vesperEcho"
        },
        {
          "choiceId": "askMara",
          "label": "Ask who keeps this place running",
          "nextLineId": "maraBar"
        },
        {
          "choiceId": "askElyra",
          "label": "Ask what the sigils mean",
          "nextLineId": "elyraRunes"
        }
      ]
    },
    {
      "lineId": "vesperEcho",
      "sceneId": "nightglassBarHub",
      "speakerId": "vesperNocturne",
      "intentTag": "route",
      "text": "A visitor can cross the tide. A memory cannot. The salt leaves its handwriting on every doorway.",
      "choices": [
        {
          "choiceId": "backLumFromVesper",
          "label": "Back to Lum",
          "nextLineId": "lumWelcome"
        }
      ]
    },
    {
      "lineId": "maraBar",
      "sceneId": "nightglassBarHub",
      "speakerId": "maraIronvale",
      "intentTag": "banter",
      "text": "I run the lamps, the doors, and the coffee machine. The impossible part is getting the machine to apologize.",
      "choices": [
        {
          "choiceId": "backLumFromMara",
          "label": "Back to Lum",
          "nextLineId": "lumWelcome"
        }
      ]
    },
    {
      "lineId": "elyraRunes",
      "sceneId": "nightglassBarHub",
      "speakerId": "elyraRunebound",
      "intentTag": "quest",
      "text": "One rune marks where you stand. The other marks where the world thinks you ought to be.",
      "choices": [
        {
          "choiceId": "backLumFromElyra",
          "label": "Back to Lum",
          "nextLineId": "lumWelcome"
        }
      ]
    },
    {
      "lineId": "maraAtShore",
      "sceneId": "echoShore",
      "speakerId": "maraIronvale",
      "intentTag": "quest",
      "text": "Hear that? The surf rings twice. First for what happened, then for the history that never did.",
      "choices": [
        {
          "choiceId": "shoreQuestion",
          "label": "Search the tide-mark",
          "nextLineId": "shoreRune"
        },
        {
          "choiceId": "shoreListen",
          "label": "Listen to the waves",
          "nextLineId": "shoreWhisper"
        }
      ]
    },
    {
      "lineId": "shoreRune",
      "sceneId": "echoShore",
      "speakerId": "elyraRunebound",
      "intentTag": "ambient",
      "text": "A broken sigil, still humming. We can sketch its shape in the studio without touching the ancient mechanism.",
      "choices": [
        {
          "choiceId": "shoreBackFromRune",
          "label": "Return to the tide",
          "nextLineId": "maraAtShore"
        }
      ]
    },
    {
      "lineId": "shoreWhisper",
      "sceneId": "echoShore",
      "speakerId": "lum",
      "intentTag": "bond",
      "text": "Funny. The ocean knows my voice. Don't tell the cathedral; it'll get jealous.",
      "choices": [
        {
          "choiceId": "shoreBackFromWhisper",
          "label": "Return to the tide",
          "nextLineId": "maraAtShore"
        }
      ]
    }
  ],
