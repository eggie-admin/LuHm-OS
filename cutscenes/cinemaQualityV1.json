{
  "schema": "luhm-os.cinema-quality.v1",
  "profile": "cinemaQuality",
  "purpose": "Offline cutscene quality profile. This is not the Android gameplay budget.",
  "target": {"width": 1080, "height": 1920, "fps": 30, "fixedFrameTiming": true},
  "character": {
    "heroGeometry": "highest camera-justified LOD",
    "faceHandsHairPriority": "HIGH",
    "facialRigRequiredWhenCanonAssetExists": true,
    "ikRequiredWhenCanonAssetExists": true,
    "secondaryMotion": "BOUNDED_AUDITED_ONLY"
  },
  "materials": {
    "workflow": "PBR",
    "expectedMaps": ["albedo", "normal", "orm"],
    "optionalMaps": ["height"],
    "heroTextureTarget": "up_to_4k_when_source_and_gpu_budget_allow",
    "normalConvention": "Godot_OpenGL"
  },
  "camera": {
    "defaultSafeFrame": "9:16",
    "presets": ["slowPushIn", "orbit", "track", "lockedPortrait"],
    "manualProfessorReviewRequired": true
  },
  "environment": {
    "useLod": true,
    "useVisibilityRanges": true,
    "useOcclusionWhenUseful": true,
    "spendDetailOnCameraVisibleSurfaces": true
  },
  "distribution": {
    "generatedOrPrivateReferenceMediaPublicByDefault": false,
    "rightsReviewRequired": true
  }
}
