#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

STATE="${HOME}/.local/state/luhm/kai9000"
HEADLESS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../sidecar" && pwd)"
OLLAMA_PID="${STATE}/ollama.pid"
LOG="${STATE}/cathedral.log"
mkdir -p "$STATE"
chmod 700 "$STATE"

alive() {
  [[ -s "$OLLAMA_PID" ]] || return 1
  kill -0 "$(cat "$OLLAMA_PID")" 2>/dev/null
}

start() {
  command -v python3 >/dev/null
  command -v ollama >/dev/null
  if ! alive; then
    nohup ollama serve >>"$LOG" 2>&1 &
    echo "$!" > "$OLLAMA_PID"
    sleep 2
  fi
  status
}

stop() {
  if alive; then
    kill "$(cat "$OLLAMA_PID")"
  fi
  rm -f "$OLLAMA_PID"
  echo "ollama stopped"
}

status() {
  printf 'ollama=%s\n' "$(alive && echo up || echo down)"
  if alive; then
    python3 "$HEADLESS_DIR/kai9000_headless.py" models || true
  fi
}

doctor() {
  python3 -m py_compile "$HEADLESS_DIR/kai9000_headless.py"
  bash -n "$0"
  printf 'python=%s\n' "$(python3 --version 2>&1)"
  printf 'ollama=%s\n' "$(ollama --version 2>&1 | head -n1)"
  status
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  doctor) doctor ;;
  models) python3 "$HEADLESS_DIR/kai9000_headless.py" models ;;
  chat) shift; python3 "$HEADLESS_DIR/kai9000_headless.py" chat "$@" ;;
  memory-candidate) shift; python3 "$HEADLESS_DIR/kai9000_headless.py" memory-candidate "$@" ;;
  *) echo "usage: $0 {start|stop|restart|status|doctor|models|chat|memory-candidate}" >&2; exit 64 ;;
esac
