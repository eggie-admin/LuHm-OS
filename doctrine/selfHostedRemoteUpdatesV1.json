{
  "schema": "luhmOs.selfHostedRemoteUpdates.v1",
  "status": "SOURCE_CANDIDATE_NOT_DEPLOYED",
  "authority": "Professor",
  "sourceLaw": "AI proposes. Policy authorizes. CI proves. Human promotes.",
  "sourceTruth": "doctrine/currentSourceTruthV3.json",
  "v1Contract": "doctrine/stablePluginUpdateSpineV1.json",
  "sourceModule": "host/mcp/luhmUpdateSpine.py",
  "endpoint": "/harness/updates/v2/manifest.json",
  "assetRoute": "/harness/updates/v2/assets/{sha256}/{filename}",
  "publicAssets": [
    "cockpit.css",
    "cockpit.js",
    "studioDeck.css",
    "studioDeck.js",
    "titan7Cockpit.js",
    "jquery-3.7.1.min.js",
    "jquery-ui-1.14.2.min.js",
    "agent-loading-sprites.json",
    "agent-roster-v1.png",
    "fontStack.css",
    "luhmSigil.svg"
  ],
  "assetsFrom": "host/harness",
  "maxAssetBytes": 2000000,
  "digest": "sha256",
  "assetUrlCache": "public max-age=300 until old digest assets durable",
  "manifests": "no-cache must-revalidate ETag",
  "mutableScriptsMustNotBeLoadedFromManifest": true,
  "singleInstallPluginStable": true,
  "githubCanonicalSource": "eggie-admin/LuHm-OS#main",
  "openAiCompatibilityFirst": true,
  "githubCompatibilitySecond": true,
  "renderTarget": "luhm-os-harness-green",
  "fontPolicy": {
    "production": "system-fonts-with-self-hosted-approved-woff2-optional",
    "bundledWoff2Files": 0,
    "noGoogleFonts": false,
    "remoteFontCdn": false,
    "thirdPartyFontUploads": false,
    "requireCommercialFontRightsReview": true,
    "requireWoff2DigestBeforeUse": true,
    "css": "host/harness/fontStack.css"
  },
  "svgPolicy": {
    "originalMark": "host/harness/luhmSigil.svg",
    "noScripts": true,
    "noForeignObject": true,
    "noRemoteReferences": true,
    "serveWithImageCsp": true,
    "rightsApprovedForOriginalSelfAuthoredMark": "CANDIDATE_ONLY"
  },
  "cdnPolicy": {
    "currentHost": "Render HTTPS same-origin",
    "useCloudflareCustomAssetFqdn": false,
    "customAssetFqdnCandidate": "assets.eggiebagelface.art",
    "activationRequirements": [
      "exact DNS + HTTPS proof",
      "approved public-only assets",
      "digest and MIME checks",
      "durable immutable object availability",
      "correct CDN cache semantics",
      "manual release signoff"
    ],
    "neverCdnCacheMcpAuthOrPrivateArt": true
  },
  "androidPolicy": {
    "contract": "doctrine/publicApkUpdateIdentityV1.json",
    "candidateRepository": "https://art.eggiebagelface.art/fdroid/repo/",
    "publicRepositoryProven": false,
    "ownerSignedIndexRequired": true,
    "stableApplicationIdAndCertificateRequired": true,
    "monotonicVersionCodeRequired": true,
    "sameSignerUpgradeEvidenceRequired": true,
    "noApkUrlsUntilSignedRelease": true,
    "silentInstall": false,
    "downgrade": false,
    "externalApkInstaller": false,
    "distroUpgradeAllowed": false
  },
  "pluginPolicy": {
    "endpoint": "https://luhm-os-harness-green.onrender.com/mcp",
    "toolAndResourceIdsRemainStable": true,
    "compatiblePresentationChangesCanUseRemoteHostRefresh": true,
    "ChatGptHostVisualMountProofRequired": true,
    "noDynamicJsFromManifest": true,
    "updateHasNoNewMcpTools": true
  },
  "guards": {
    "pathTraversalBlock": true,
    "symlinkBlock": true,
    "noDynamicUploads": true,
    "noRemoteScripts": true,
    "noBackgroundInstall": true,
    "noAgentActivation": true,
    "noSqlMigration": true,
    "noDistroUpgrade": true,
    "noAutoDeploy": true,
    "noAutoMerge": true,
    "noPublicPrivateArt": true,
    "buildRequiresExactCast": true
  },
  "remoteScriptExecution": false,
  "automaticApkInstall": false,
  "runtimeCdnScripts": false,
  "crownStatus": "STOP",
  "promotion": false
}
