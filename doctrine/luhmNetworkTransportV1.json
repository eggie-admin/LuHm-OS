  "intendedArchitecture": {
    "controller": "cloudflareNetworkController",
    "inboundPublicClient": {
      "requiredProtocol": "https",
      "httpPolicy": "redirectAtCloudflareEdgeToHttps",
      "redirectProtectsInitialHttpRequest": false,
      "sensitiveDataMayBeSentBeforeHttps": false
    },
    "localIPv4ControllerSocket": {
      "address": "127.0.0.1",
      "protocol": "http",
      "encrypted": false,
      "scope": "sameHostLoopbackOnly",
      "allowed": true,
      "bindAddressesForbidden": [
        "0.0.0.0",
        "LAN IPv4 address",
        "public IPv4 address"
      ],
      "accessibleFromRemoteNetwork": false
    },
    "cloudflareTunnel": {
      "connector": "cloudflared",
      "connectorToCloudflare": "outboundEncryptedTunnel",
      "inboundPortsRequired": false,
      "localServiceUrlProtocol": "http",
      "localOriginHopEncrypted": false,
      "localOriginHttpAllowedOnlyWhenSameHostLoopback": true,
      "automaticallyUpgradesLocalHttpToTls": false
    },
    "remoteServiceSockets": {
      "requiredProtocol": "https",
      "peerCertificateValidation": true,
      "allowCleartextHttp": false,
      "cloudflareRedirectIsNotTlsForBackendClientSockets": true
    }
  },
  "invariants": {
    "plaintextHttpAllowedOnlyOnIPv4Loopback": true,
    "publicClientTrafficRequiresHttps": true,
    "httpRedirectIsNotTransportEncryption": true,
    "cloudflareTunnelEncryptsConnectorEdgeHop": true,
    "tunnelDoesNotEncryptLocalHttpOriginHop": true,
    "remoteServiceTlsIsConfiguredAndVerifiedPerConnection": true,
    "noSensitiveDataBeforeTls": true,
    "dnsPresenceDoesNotProveTunnelOrRuntime": true,
    "doctrineDoesNotClaimDeployment": true,
    "localBindMustUseIpv4Loopback": true
  },
  "proofRequiredBeforeTunnelActivation": [
    "exact service and environment resolved",
