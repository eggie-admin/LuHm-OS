    "fastApiCloud": {
      "role": "optionalAlternativeTransport",
      "authenticatedDeploymentVerified": false,
      "defaultDeploymentTarget": false,
      "cannotOverrideRenderFreeTierPolicy": true
    }
  },
  "fastMesh": {
    "router": "tools/lumTaskRouter.py",
    "roster": "doctrine/agentSystemDeploymentV1.json",
    "boss": "lum",
    "plannedOnly": true,
    "companyHold": "doctrine/companyWideOperationalQuarantineV1.json",
