      "interfaceAuthority": false,
      "sourceAuthority": false,
      "organizationAndProjectsReachable": true,
      "billingTierVerified": false,
      "developerPerksVerified": false,
      "billableExecutionAllowed": false
    },
    "github": {
      "role": "primaryResearchAndDevelopmentStudio",
      "repository": "eggie-admin/LuHm-OS",
      "connector": "directGitHub",
      "owns": [
        "canonicalSource",
        "versionHistory",
        "pullRequests",
        "tests",
        "ciEvidence"
