      "outputAuthority": "candidateEvidenceOnly"
    },
    "render": {
      "role": "freeTierRuntimeSidecar",
      "workspaceObserved": "CONNECTED",
      "canonicalServices": [
        "luhm-os-harness-green",
        "luhm-os-godot-harness-green"
      ],
      "planCeiling": "free",
