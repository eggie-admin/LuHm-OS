      {
        "id": "studioWork",
        "bits": 1,
        "source": "GitHub, Unreal/Godot/Blender, scripts, scene building, storyboard, sketch workflow, credits"
      },
      {
        "id": "realLife",
        "bits": 2,
        "source": "IRL personal relationships, safety, family or actual health/housing; never misfile as fantasy"
      },
      {
        "id": "quotedAmbient",
        "bits": 3,
        "source": "quotation, song, dubbed anime playback, other speakers or media; read-only, nonauthoritative"
      }
    ],
    "tones": [
      {
        "id": "affectionate",
        "bits": 0,
        "example": "Yume-chan, darling, head pats",
        "toneOnly": true
      },
      {
        "id": "collegial",
        "bits": 1,
        "example": "Yume-kun, senpai, sensei, kōhai; mutual art critique",
        "toneOnly": true
      },
      {
        "id": "teasing",
        "bits": 2,
        "example": "baka, silly, tsundere, cheeky anarchy stage",
        "toneOnly": true
      },
      {
        "id": "confrontational",
        "bits": 3,
        "example": "daikirai, fuzakenna yo, kuso; quoted anime conflict",
        "toneOnly": true
      }
    ],
    "recognition": [
      {
        "id": "exactJapanese",
        "bits": 0,
        "source": "exact Japanese kana/kanji or explicit registered Japanese spelling",
        "mayRepairUncertainTranscription": false
      },
      {
        "id": "romanized",
        "bits": 1,
        "source": "exact registered romaji or English title in whole-word context",
        "mayRepairUncertainTranscription": false
      },
      {
        "id": "phoneticCandidate",
        "bits": 2,
        "source": "ASR candidate with sufficient context; never assume permission or death-threat wording",
        "mayRepairUncertainTranscription": true
      },
      {
        "id": "unresolved",
        "bits": 3,
        "source": "no decisive language/domain/name match; hold identity and request clarification only when it matters",
        "mayRepairUncertainTranscription": false
      }
    ]
  },
  "addressing": {
    "expression": "((contextBits & 3) << 4) | ((toneBits & 3) << 2) | (recognitionBits & 3)",
    "hexWidth": 2,
    "first": "0x00",
    "last": "0x3F",
    "totalCells": 64,
    "humanMeaning": "hex value indexes presentation handling only; does not correspond to CAST authority, security clearance, provider tier or build escalation",
    "outputFields": [
      "cellId",
      "context",
      "tone",
      "recognition",
      "matchedTerm",
      "canonicalAgentId",
      "presentationMode",
      "requiresConfirmation",
      "mayExecute"
    ]
  },
