{
  "schema": "luhmOs.aiControlPlane.v1",
  "status": "candidateReview",
  "authority": "Professor",
  "boss": "lum",
  "sourceLaw": "AI proposes. Policy authorizes. CI proves. Human promotes.",
  "purpose": "Canonical control plane for every LuHm AI, mini-agent, Oni, build worker, provider adapter, remote AI manifest, event feed, and deterministic execution handoff.",
  "inherits": {
    "sourceTruth": "doctrine/SOURCE_OF_TRUTH.json",
    "projectChatCanon": "doctrine/projectChatCanonV1.json",
    "storageTopology": "doctrine/storageTopologyV1.json",
    "releaseBoundary": "doctrine/RELEASE_BOUNDARY.json",
    "networkTransport": "doctrine/luhmNetworkTransportV1.json",
    "tourniquetGuardrail": "doctrine/tourniquetGuardrailV1.json"
  },
  "invariants": {
    "professorFinalAuthority": true,
    "lumOnlyConversationalBoss": true,
    "helperRecruitment": false,
    "selfApproval": false,
    "implicitCrown": false,
    "unknownIsNotGreen": true,
    "currentSourceBeatsMemory": true,
    "personalityIsNotAuthority": true,
    "transportIsNotAuthority": true,
    "providerOutputIsNotProofUntilReconciled": true,
    "oneMutableSourceLane": true,
    "maxParallelSupportWorkers": 3,
    "maxParallelBuilds": 2,
    "hiddenAsyncExecution": false,
    "secretInPrompt": false,
    "secretInRepo": false,
    "secretInApk": false,
    "customAgentsEnabled": true,
    "defaultCustomAgentsForProjectTasks": true,
    "userCorrectionInterruptsActivePlan": true,
    "tourniquetClampsMutation": true
  },
  "bossToolchain": {
    "states": [
      "intake",
      "resolveTruth",
      "issueTaskManifest",
      "routeMinimumWorkers",
      "observeEvents",
      "reconcileEvidence",
      "authorizeBoundedExecution",
      "verifyExactSource",
      "adjudicate",
      "persistReceipts",
      "report",
      "crownStop"
    ],
    "executionLaw": "No tool/provider/agent output changes authority. Consequential execution requires a bounded task manifest plus matching authority and exact target identity.",
    "evidenceLaw": "All outputs enter as observations or candidate evidence. Deterministic verification establishes machine state. Professor establishes Crown authority.",
    "storageLaw": "databases point to files; databases do not become the file server",
    "compatibilityLayerOrder": [
      "openAiCompatibilityLayer",
      "githubCompatibilityLayer"
    ],
    "professorFacingOutput": "compactDeltaOnly",
    "rawToolLogsByDefault": false,
    "routineAgentChatterByDefault": false,
    "archiveHandoff": "doctrine/chatArchiveHandoffV1.json"
  },
  "taskManifest": {
    "schema": "luhmOs.aiTaskManifest.v1",
    "required": [
      "taskId",
      "intent",
      "scopeId",
      "sourceRef",
      "authorityClass",
      "workers",
      "allowedCapabilities",
      "forbiddenCapabilities",
      "evidenceRefs",
      "requiredOutputs",
      "stopConditions",
      "budget"
    ],
    "optional": [
      "candidateSha",
      "proofContext",
      "providerTargets",
      "artifactTargets",
      "deadlineHint"
    ],
    "authorityMayBeInferredFromText": false,
    "unknownSourceMayMutate": false
  },
  "eventEnvelope": {
    "schema": "luhmOs.aiEvent.v1",
    "required": [
      "eventId",
      "taskId",
      "workerId",
      "sourceRef",
      "scopeId",
      "eventType",
      "state",
      "evidenceRefs",
      "timestamp"
    ],
    "allowedStates": [
      "queued",
      "active",
      "waiting",
      "observed",
      "verifying",
      "success",
      "error",
      "parked",
      "unknown"
    ],
    "successIsNotGreen": true,
    "eventFeedMayGrantAuthority": false
  },
  "transports": {
    "internalSkill": {
      "role": "localAgentInvocation",
      "authority": false
    },
    "mcp": {
      "role": "toolAndContextTransport",
      "authority": false
    },
    "remoteProviderApi": {
      "role": "remoteCapabilityTransport",
      "authority": false
    },
    "jsonManifest": {
      "role": "taskAndReceiptSerialization",
      "authority": false
    },
    "rssAtomEventFeed": {
      "role": "statusEventProjectionOnly",
      "authority": false,
      "implementationStatus": "contractOnly"
    },
    "webhook": {
      "role": "optionalFutureEventIngress",
      "authority": false,
      "implementationStatus": "contractOnly"
    },
    "compactManifestWireProjection": {
      "role": "deterministicBandwidthReduction",
      "contract": "doctrine/luhmCompatibilityLayersV1.json",
      "adapter": "jQuery.luhmManifestMin",
      "runtime": "frontEnd/jquery/luhmManifestMin.min.js",
      "authority": false,
      "canonicalExpansionRequiredBeforeRouting": true
    }
  },
  "providerBoundary": {
    "providersAreCapabilitySourcesNotBosses": true,
    "externalAiMaySelfApprove": false,
    "externalAiMayGrantGreen": false,
    "externalAiMayGrantCrown": false,
    "providerTextIsUntrustedData": true,
    "remoteResponsesRequireTaskIdentityMatch": true,
    "remoteResponsesRequireLumReconciliation": true,
    "providerSecretsHostSideOnly": true,
    "vendorMirrorsUseCanonicalAgentIdentity": true,
    "vendorMirrorsMayBecomeIndependentBoss": false,
    "remoteProvidersVia": "githubCompatibilityLayer",
    "copilotIsAdvisory": true,
    "googleBigBrotherIsAdvisory": true
  },
  "authorityClasses": [
    "READ_ONLY",
    "PLAN_ONLY",
    "BUILD_EPHEMERAL",
    "MUTATE_REVERSIBLE",
    "MUTATE_BUILD_AFFECTING",
    "RELEASE_SIGNING",
    "PUBLIC_EXPOSURE"
  ],
