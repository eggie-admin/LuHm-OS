  "remoteAiManifest": {
    "schema": "luhmOs.remoteAiManifest.v1",
    "implementationStatus": "contractOnly",
    "required": [
      "providerId",
      "capabilityId",
      "taskId",
      "sourceRef",
      "scopeId",
      "inputRefs",
      "requiredOutputSchema",
      "budget",
      "stopConditions"
    ],
    "responseRequired": [
      "providerId",
      "taskId",
      "sourceRef",
      "scopeId",
      "responseId",
      "outputRefs",
      "claims",
      "timestamp"
    ],
    "responseAuthority": false
  },
  "receipts": {
    "aiReceiptMustBind": [
      "taskId",
      "sourceRef",
      "scopeId",
      "workerId",
      "inputRefs",
      "outputRefs",
      "state"
    ],
    "durableBinaryReceiptRequiresDrive": true,
    "githubStoresPointersAndReceipts": true,
    "openAiStoresSemanticStateOnly": true
  },
  "crownStatus": "stop",
  "principals": {
    "professorCrown": {
      "kind": "humanAuthorityGate",
      "authority": "Professor",
      "machineWorker": false,
      "parallelClass": "humanGate"
    }
  },
  "goddessCabinet": {
    "contract": "doctrine/lumGoddessCabinetV1.json",
    "members": [
      "lum",
      "urdDoctorGoddess",
      "belldandySecretary",
      "skuldResearch"
    ],
    "sharedContextRequired": true,
    "peerAwareness": "readOnly",
    "disagreementsReturnTo": "lum",
    "consensusAuthority": false
  },
  "customAgentContract": {
    "configPath": ".codex/agents/",
    "projectConfig": ".codex/config.toml",
    "defaultSet": [
      "urdDoctorGoddess",
      "belldandySecretary",
      "skuldResearch",
      "yume"
    ],
    "activation": "everyLuHmProjectTask",
    "activationBoundaries": [
      "currentTaskEnvelope",
      "sourceRef",
      "scopeId",
      "budget",
      "stopConditions"
    ],
    "afterTask": "terminate",
    "phraseTrigger": "doctrine/luhmChatMagicTriggerV1.json",
    "spokenAliasesResolveToCanonicalIdentity": true,
    "presenceIsNotInference": true,
    "inferencePolicy": "matchingSemanticTriggerOrMaterialStateChangeOnly",
    "unchangedStateReinvoke": false,
    "specialistsLazyByDefault": true,
    "lumDelegationLaw": "Lum delegates owned specialty work to its goddess or specialist and integrates the returned packet instead of duplicating that procedure in boss context."
  },
  "namingContract": "New LuHm-owned identifiers and agent config filenames use lowerCamelHump; vowel-ripped terms are explicit aliases only.",
  "compatibilityLayersContract": "doctrine/luhmCompatibilityLayersV1.json",
  "operationTitan7": {
    "contract": "doctrine/operationTitan7V1.json",
    "kind": "callablePluginProtocol",
    "entryPoint": "jQuery.fn.operationTitan7",
    "alwaysRunning": false,
    "scheduled": false,
    "escalationOrder": [
      "forFuckSake",
      "scorchedEarth",
      "finalForm"
    ]
  },
  "chatExperienceContract": "doctrine/chatExperienceV1.json",
  "networkTransportContract": {
    "doctrine": "doctrine/luhmNetworkTransportV1.json",
    "localhostHttpAllowedOnly": "127.0.0.1 loopback on the same host",
    "cloudflareTunnelRuntimeClaim": "require exact runtime evidence",
    "remoteServiceProtocol": "httpsWithPeerValidation",
    "redirectsDoNotEncryptInitialHttpRequest": true
  },
  "voiceAliasPolicy": {
    "doctrine": "doctrine/luhmChatMagicTriggerV1.json",
    "nickname": "DreamChan",
    "scope": "voiceDictationOnly",
    "canonicalTarget": "yume",
    "typedTextCreatesAliasOrAgent": false
  },
