{
  "schema": "luhmOs.inChatExperience.v1",
  "status": "SOURCE_CONFIGURED_CANDIDATE",
  "authority": "Professor",
  "boss": "lum",
  "purpose": "One canonical runtime contract for the LuHm ChatGPT cockpit, agent activity, roleplay, pets, and the bounded Godot handoff.",
  "sources": {
    "intentRouter": "doctrine/humanCenteredIntentRouterV2.json",
    "activity": "doctrine/chatActivityPresentationV1.json",
    "roleplay": "doctrine/codingRoleplayDirectorV2.json",
    "pets": "doctrine/characterPetPresentationV1.json",
    "loadingSprites": "doctrine/agentLoadingSpriteManifestV1.json",
    "agentControl": "doctrine/luhmAiControlPlaneV1.json",
    "sourceTruth": "doctrine/currentSourceTruthV3.json",
    "crownFlow": "doctrine/chatGptPluginCrownFlowV1.json",
    "runtimeReceipt": "doctrine/chatGptPluginRuntimeReceiptV1.json",
    "openingDayStaffTraining": "doctrine/openingDayStaffTrainingV1.json",
    "apiSpine": "doctrine/apiSpineV1.json",
    "trafficController": "doctrine/cloudflareAirTrafficControllerV1.json",
    "chatPrecisionCommand": "doctrine/chatPrecisionCommandV1.json"
  },
  "runtime": {
    "tool": "luhm_open_cockpit",
    "resourceUri": "ui://luhm-os/cockpit-v2.html",
    "surface": "mcp-app",
    "standaloneHarness": "/harness/",
    "panels": [
      "sourceTruth",
      "crownFlow",
      "openingDay",
      "apiSpine",
      "airTraffic",
      "activeCast",
      "activity",
      "roleplay",
      "petDock",
      "commandCapsule",
      "precisionCommands",
      "godotHandoff"
    ],
    "godotEmbeddingInChat": false,
    "godotHandoffPath": "/harness/godot-export/index.html",
    "providerPlumbingHiddenFromEndUser": true,
    "stageTwo": {
      "layout": "verticalScroll",
      "parallax": "cssLayered",
      "commandSchema": "doctrine/chatPrecisionCommandV1.json",
      "inChatFirst": true,
      "providerPlumbingHidden": true
    }
  },
  "turnModel": {
    "sequence": [
      "professorIntent",
      "intentRoute",
      "activeCast",
      "activityEvent",
      "roleplayProjection",
      "evidenceReconcile",
      "professorFacingTurn"
    ],
    "activityEvidenceStates": [
      "pending",
      "proved",
      "failed"
    ],
    "visualStates": [
      "IDLE",
      "WORKING",
      "VERIFY",
      "PASS",
      "BLOCKED"
    ],
    "roleplayMayChangeEvidence": false,
    "presentationMayGrantAuthority": false
  },
  "activeCast": {
    "boss": "lum",
    "resident": [
      "urdDoctorGoddess",
      "belldandySecretary",
      "skuldResearch"
    ],
    "specialistsFromControlPlane": true,
    "maxParallelSupportWorkers": 3,
    "onlyShowWorkersActuallyRouted": true
  },
  "petDock": {
    "contract": "doctrine/characterPetPresentationV1.json",
    "thoughtBubbleMaxLines": 3,
    "speakerRequired": true,
    "expressionRequired": true,
    "fakeBackgroundActivityForbidden": true
  },
  "activity": {
    "contract": "doctrine/chatActivityPresentationV1.json",
    "semanticGrouping": true,
    "numericProgressRequiresEvidence": true,
    "unknownEvidenceState": "VERIFY",
    "passRequiresProvedEvidence": true
  },
  "roleplay": {
    "contract": "doctrine/codingRoleplayDirectorV2.json",
    "machineStateSeparate": true,
    "decorativeGreenForbidden": true,
    "rawChainOfThoughtForbidden": true
  },
  "proof": {
    "sourceConfiguredDoesNotEqualLiveHostProof": true,
    "toolResultMustExposeThisSchema": true,
    "chatResourceMustMatchResourceUri": true,
    "standaloneHarnessMustExposeThisSchema": true
  },
  "promotion": false,
  "crownStatus": "STOP",
  "authorityBoundary": {
    "readOnlyPlugin": true,
    "mutationAuthority": false,
    "greenAuthority": false,
    "publicationAuthority": false,
    "signingAuthority": false,
    "crownAuthority": false
  },
  "firstRun": {
    "contract": "doctrine/openingDayStaffTrainingV1.json",
    "mode": "openingDayOrientation",
    "oneInstallTarget": true,
    "manualBackendSetupForEndUser": false
  }
}
