{
  "schema": "luhm-os.professor-cast-bridge.v1",
  "date": "2026-10-02",
  "status": "PROPOSED_CONTROL_PLANE",
  "authority": "Professor",
  "purpose": "Allow an explicit owner-authored GitHub PR comment containing a milestone and exact current-main SHA to dispatch exactly one CAST-gated Android Web3 build/release workflow.",
  "trigger": {
    "event": "issue_comment.created",
    "requiresPullRequestContext": true,
    "requiredActor": "github.repository_owner",
    "syntax": "/cast androidWeb3Cockpit <40-char-current-main-sha>",
    "exactMainMatch": true
  },
  "dispatch": {
    "workflow": "android-testing-build.yml",
    "ref": "main",
    "cast": "cast",
    "milestoneId": "androidWeb3Cockpit",
    "publishPrerelease": true,
    "releaseTag": "android-web3-<sha8>-r<bridgeRunId>"
  },
  "safety": {
    "noPersistentBuildAuthorization": true,
    "noWildcardActor": true,
    "noSourceDrift": true,
    "noStableRelease": true,
    "noProductionSigning": true,
    "noMergeAuthority": true,
    "noCrownAuthority": true
  },
  "crownStatus": "STOP"
}
