    "canonicalMachineIdentity": {
      "urdDoctorGoddess": [
        "Urd",
        "rd"
      ],
      "belldandySecretary": [
        "Belldandy",
        "Bllndy"
      ],
      "skuldResearch": [
        "Skuld",
        "Skld"
      ],
      "yume": [
