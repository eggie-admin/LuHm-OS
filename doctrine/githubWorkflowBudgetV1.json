{
  "schema": "luhmOs.githubWorkflowBudget.v1",
  "status": "PROPOSED_SOURCE_ONLY",
  "authority": "Professor",
  "maxCommitsPerWorkflow": 50,
  "purpose": "Keep GitHub/Codespaces work bounded so one task does not turn into an unreviewable commit avalanche.",
  "laws": [
    "one_workflow_task_may_not_span_more_than_50_candidate_commits",
    "prefer_small_coherent_commits_or_a_squashed_candidate_before_promotion",
    "history_research_may_sample_at_most_50_commits_per_single_workflow_pass_unless_professor_explicitly_selects_a_deeper_audit",
    "new_source_identity_restarts_evidence_gates",
    "workflow_budget_does_not_grant_merge_deploy_publish_or_crown_authority",
    "history_lane_numbers_are_relative_to_head_not_absolute_commit_ids",
    "latest_25_commits_are_active_proposed_lane",
    "commits_26_through_49_are_maturation_buffer_not_authority_lane",
    "commits_50_or_more_behind_head_are_normal_proposed_source_truth_baseline",
    "newer_proposal_does_not_silently_rewrite_mature_doctrine_without_reconciliation"
  ],
  "codespaces": {
    "preferredFor": [
      "isolated_repo_inspection",
      "source_mutation",
      "deterministic_audits",
      "tooling_smoke_tests",
      "pull_request_preparation"
    ],
    "notProofOf": [
      "physical_android_device_state",
      "local_samsung_runtime",
      "production_deployment",
      "secret_availability",
      "provider_entitlement"
    ],
    "secretLaw": "Use Codespaces secret storage or environment injection; never commit credentials, tokens, signing keys, or private Drive identifiers."
  },
  "crownStatus": "STOP",
  "promotion": false,
  "historyLanes": {
    "basis": "relativeCommitDistanceFromCurrentHead",
    "activeProposedLane": {
      "commitDistance": {
        "min": 0,
        "max": 25
      },
      "meaning": "current experimental/proposed work",
      "authority": "candidateOnly",
      "mayOverrideMatureDoctrine": false,
      "promotionRequired": true
    },
    "maturationBuffer": {
      "commitDistance": {
        "min": 26,
        "max": 49
      },
      "meaning": "aging observation buffer between active proposal and mature proposed doctrine",
      "authority": "nonAuthoritativeTransition",
      "mayBeUsedAsEvidence": true,
      "mayOverrideMatureDoctrine": false
    },
    "proposedSourceTruthLane": {
      "commitDistance": {
        "min": 50,
        "max": null
      },
      "meaning": "normal proposed source-of-truth doctrine and historical working baseline",
      "authority": "proposedDoctrineBaseline",
      "professorPromotionStillRequiredForCrown": true
    },
    "precedence": [
      "exact current Crowned law and receipts",
      "explicit Professor correction",
      "proposedSourceTruthLane for baseline doctrine",
      "activeProposedLane for current candidate work",
      "maturationBuffer for context only"
    ],
    "laneCount": 2,
    "bufferIsNotThirdLane": true
  }
}
