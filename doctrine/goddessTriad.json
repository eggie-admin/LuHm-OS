    "summonAll": "summon the goddesses",
    "takeBreak": "goddesses take a break",
    "resumeAll": "goddesses return",
    "summonOnePattern": "summon <urd|skuld|belldandy>",
    "directAddressPattern": "<urd|skuld|belldandy>: <message>"
  },
  "grepRules": [
    {"id": "legacyDoctorName", "pattern": "\\b(Dr\\.?[[:space:]]*Nao|DrNao|doctorOni)\\b", "severity": "info", "enabled": true, "purpose": "Find legacy Doctor Oni references that should resolve to Urd without rewriting immutable receipts."},
    {"id": "legacySecretaryName", "pattern": "\\b(Secretary[[:space:]]+Oni|secretaryOni|Fumi|fumiSecretaryOni)\\b", "severity": "info", "enabled": true, "purpose": "Find legacy secretary references that should resolve to Belldandy without erasing provenance."},
    {"id": "unsafeCrownPhrase", "pattern": "\\b(self[- ]?crown|auto[- ]?crown|agent[[:space:]]+approved)\\b", "severity": "red", "enabled": true, "purpose": "Catch wording that implies autonomous promotion authority."},
    {"id": "unsafeBuildPhrase", "pattern": "\\b(auto[- ]?build|build[[:space:]]+without[[:space:]]+cast|implicit[[:space:]]+cast)\\b", "severity": "red", "enabled": true, "purpose": "Catch build language that conflicts with the Professor CAST gate."},
    {"id": "truthVibesPhrase", "pattern": "\\b(probably|seems|should[[:space:]]+be|basically)[[:space:]]+(green|deployed|installed|merged|published|proven)\\b", "severity": "amber", "enabled": true, "purpose": "Flag vibe-based project-state claims for Urd review."}
  ],
  "limits": {
    "maxActiveGoddesses": 3,
    "maxParallelResearchTasks": 3,
    "maxAutomaticResearchQueries": 8,
    "defaultEvidenceFreshnessHours": 24,
    "maxReceiptRefsPerHandoff": 20,
    "maxPersonaBanterLines": 2
  }
