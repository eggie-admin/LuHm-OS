      "pkg update",
      "pkg upgrade"
    ],
    "prootInstall": [
      "pkg install proot-distro"
    ],
    "prootStart": [
      "proot-distro search ubuntu",
      "proot-distro install ubuntu:24.04",
      "proot-distro login ubuntu"
    ],
