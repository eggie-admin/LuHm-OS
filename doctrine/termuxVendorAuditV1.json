    "github": {
      "appReleaseLane": "tagged GitHub Releases",
      "appPreviewLane": "per-commit GitHub Actions artifacts",
      "signingFamily": "termuxGitHubDebugTestKeyFamily",
      "android7PlusVariant": "apt-android-7",
      "architecturePreference": "arm64-v8a",
      "actionArtifactsRequireLoggedInGitHub": true
    },
    "fdroid": {
      "appLane": "F-Droid build and signing infrastructure",
      "signingFamily": "fdroidTermuxFamily",
      "updateLag": "may trail GitHub releases",
      "mixingWithGithubFamilyForbidden": true
    },
    "googlePlay": {
      "role": "separate experimental branch",
      "compatibility": "not assumed interchangeable with F-Droid/GitHub families"
    }
  },
  "hardRule": "Termux app and plugin APKs installed together must come from one signing/source family.",
