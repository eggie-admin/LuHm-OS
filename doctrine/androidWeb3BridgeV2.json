{
  "schema": "luhmOs.androidWeb3Bridge.v2",
  "status": "PROPOSED_CANDIDATE",
  "authority": "Professor",
  "pluginName": "AndroidWeb3Cockpit",
  "localOrigin": "https://appassets.androidplatform.net",
  "assetPrefix": "/assets/",
  "startUrl": "https://appassets.androidplatform.net/assets/index.html",
  "jsObject": "LuHmNative",
  "javascriptToNative": [
    {
      "type": "cockpitReady",
      "effect": "emit cockpit_ready(webViewPackageVersion) to Godot"
    },
    {
      "type": "oniRequested",
      "effect": "validate canonical Oni name, hide WebView overlay, emit oni_requested(name) to Godot, show bounded summon acknowledgement; routing only, execution does not start"
    },
    {
      "type": "worldRequested",
      "effect": "hide WebView overlay and emit world_requested to Godot"
    },
    {
      "type": "aramoorRequested",
      "effect": "hide WebView overlay, emit aramoor_requested to existing Godot Main adapter; private offline Aramoor world only; no shell/worker/deployment authority"
    }
  ],
  "godotToNative": [
    {
      "method": "showCockpit",
      "effect": "show/focus WebView overlay"
    },
    {
      "method": "hideCockpit",
      "effect": "hide WebView overlay"
    },
    {
      "method": "getWebViewVersion",
      "effect": "return current WebView package and version"
    }
  ],
  "security": {
    "allowedMainFrameOnly": true,
    "exactOriginOnly": true,
    "arbitraryNavigation": false,
    "networkFallback": false,
    "addJavascriptInterface": false,
    "fileScheme": false,
    "contentScheme": false,
    "mixedContent": false,
    "arbitraryCommands": false,
    "shellAuthority": false,
    "crownAuthority": false
  },
  "runtimeProof": "SAMSUNG_COCKPIT_VISUAL_LAUNCH_OBSERVED_20261114_ARMOOR_NATIVE_HANDOFF_PENDING",
  "legacySource": "doctrine/ANDROID_WEB3_BRIDGE_V1.json",
  "crownStatus": "STOP"
}
