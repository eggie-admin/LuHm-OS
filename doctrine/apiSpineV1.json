{
  "schema": "luhmOs.apiSpine.v1",
  "status": "SOURCE_CONFIGURED_CANDIDATE",
  "authority": "Professor",
  "boss": "lum",
  "purpose": "Stable capability-first API spine so LuHm behavior survives provider, model, endpoint, entitlement, and network-edge changes without rewriting the product surface.",
  "sourceLaw": "AI proposes. Policy authorizes. CI proves. Human promotes.",
  "publicInterface": {
    "systemHarness": "https://luhm-os-harness-green.onrender.com/mcp",
    "chatToolSurface": "MCP",
    "providerSpecificDetailsVisibleToEndUser": false,
    "providerSwapMayChangeUserWorkflow": false,
    "providerSwapMayChangeAuthority": false
  },
  "routing": {
    "principle": "capabilityFirstProviderSecond",
    "sequence": [
      "normalizeIntent",
      "resolveRequiredCapabilities",
      "reuseCurrentReceipts",
      "preferDeterministicLocalWhenSufficient",
      "selectEligibleProviderAdapter",
      "applyBudgetAndEntitlementGate",
      "executeBoundedTask",
      "normalizeProviderReceipt",
      "urdAdjudicate",
      "lumReconcile",
      "belldandyPersist"
    ],
    "providerNameRequiredFromUser": false,
    "modelNameRequiredFromUser": false,
    "silentAuthorityEscalation": false,
    "unknownEntitlement": "fallbackOrStop",
    "unknownModelIdentity": "allowedOnlyWhenModelIdentityIsNotMaterial"
  },
  "adapterContract": {
    "requiredFields": [
      "providerId",
      "adapterId",
      "capabilityClasses",
      "readiness",
      "credentialSource",
      "endpointSource",
      "entitlementState",
      "modelIdentityState",
      "fallbackAdapters",
      "receiptSchema"
    ],
    "stableReceiptSchema": "luhmOs.providerExecutionReceipt.v1",
    "stableErrorSchema": "luhmOs.providerFailure.v1",
    "providerNativePayloadMayEscapeAdapter": false,
    "providerNativeErrorMayEscapeAdapter": false,
    "adapterChangeMayRewriteProductSchema": false,
    "adapterChangeMayGrantAuthority": false
  },
  "providers": {
    "openAi": {
      "providerId": "openAi",
      "adapterId": "openAiResponses",
      "capabilityClasses": [
        "interactiveReasoning",
        "toolOrchestration",
        "semanticSynthesis"
      ],
      "readiness": "RECEIPT_REQUIRED",
      "credentialSource": "hostSecretStore",
      "endpointSource": "providerSdkOrConfiguredApiBase",
      "entitlementState": "UNKNOWN_UNTIL_PROVIDER_RECEIPT",
      "modelIdentityState": "UNKNOWN_UNTIL_PROVIDER_RECEIPT",
      "fallbackAdapters": [
        "googleAi",
        "deterministicLocal"
      ],
      "receiptSchema": "luhmOs.providerExecutionReceipt.v1"
    },
    "googleAi": {
      "providerId": "googleAi",
      "adapterId": "bigBrother",
      "capabilityClasses": [
        "bulkResearch",
        "largeContextReview",
        "compatibilityResearch",
        "candidateReview"
      ],
      "readiness": "RECEIPT_REQUIRED",
      "credentialSource": "hostSecretStoreOrConnectedProvider",
      "endpointSource": "providerSdkOrConfiguredApiBase",
      "entitlementState": "UNKNOWN_UNTIL_PROVIDER_RECEIPT",
      "modelIdentityState": "UNKNOWN_UNTIL_PROVIDER_RECEIPT",
      "fallbackAdapters": [
        "deterministicLocal",
        "openAi"
      ],
      "receiptSchema": "luhmOs.providerExecutionReceipt.v1"
    },
    "githubCopilot": {
      "providerId": "githubCopilot",
      "adapterId": "githubCompatibilityLayer",
      "capabilityClasses": [
        "repositoryContext",
        "codingAdvice",
        "pullRequestReview"
      ],
      "readiness": "SOURCE_CONFIGURED_EXECUTION_RECEIPT_REQUIRED",
      "credentialSource": "connectedGitHubIdentity",
      "endpointSource": "providerManaged",
      "entitlementState": "UNKNOWN_UNTIL_PROVIDER_RECEIPT",
      "modelIdentityState": "UNKNOWN_UNTIL_PROVIDER_RECEIPT",
      "fallbackAdapters": [
        "lumRepositoryEvidence"
      ],
      "receiptSchema": "luhmOs.providerExecutionReceipt.v1"
    },
    "huggingFace": {
      "providerId": "huggingFace",
      "adapterId": "huggingFaceFreeTier",
      "capabilityClasses": [
        "boundedModelInference",
        "modelMetadata",
        "datasetMetadata"
      ],
      "readiness": "CANDIDATE_PROVIDER_UNPROVEN",
      "credentialSource": "hostSecretStoreWhenRequired",
      "endpointSource": "providerSdkOrConfiguredApiBase",
      "entitlementState": "STRICT_FREE_TIER_REQUIRED",
      "modelIdentityState": "EXACT_MODEL_RECEIPT_REQUIRED",
      "fallbackAdapters": [
        "deterministicLocal"
      ],
      "receiptSchema": "luhmOs.providerExecutionReceipt.v1"
    },
    "edgeGallery": {
      "providerId": "edgeGallery",
      "adapterId": "localEdgeGallery",
      "capabilityClasses": [
        "localInference",
        "offlineCompanion"
      ],
      "readiness": "UNCONFIGURED_EVIDENCE_PENDING",
      "credentialSource": "noneUnlessExactRuntimeRequiresIt",
      "endpointSource": "localRuntimeReceipt",
      "entitlementState": "LOCAL_RUNTIME_RECEIPT_REQUIRED",
      "modelIdentityState": "EXACT_LOCAL_MODEL_RECEIPT_REQUIRED",
      "fallbackAdapters": [
        "deterministicLocal",
        "openAi",
        "googleAi"
      ],
      "receiptSchema": "luhmOs.providerExecutionReceipt.v1"
    }
  },
  "resilience": {
    "retryPolicy": {
      "defaultMaxAttempts": 2,
      "retryOnly": [
        "timeout",
        "transient5xx",
        "rateLimitWithRetryAfter"
      ],
      "neverBlindRetry": [
        "authenticationFailure",
        "authorizationFailure",
        "invalidRequest",
        "policyBlock",
        "unknownMutationOutcome"
      ]
    },
    "circuitBreaker": {
      "enabledByContract": true,
      "state": [
        "closed",
        "open",
        "halfOpen"
      ],
      "providerFailureMayDisableWholeSpine": false,
      "fallbackMustPreserveAuthorityBoundary": true
    },
    "idempotency": {
      "truthSensitiveTasksRequireTaskId": true,
      "mutationTasksRequireExplicitIdempotencyKey": true,
      "retryMayDuplicateConsequentialAction": false
    },
    "degradedMode": {
      "allowed": true,
      "mustBeVisibleInReceipt": true,
      "mayPretendFullCapability": false
    }
  },
  "secrets": {
    "sourceControl": false,
    "pluginPackage": false,
    "androidClient": false,
    "browserJavascript": false,
    "logs": false,
    "allowedLocations": [
      "approvedHostSecretStore",
      "providerManagedOAuthOrConnector"
    ],
    "rotationShouldRequireProductCodeChange": false
  },
  "observability": {
    "rawPromptsInLogsByDefault": false,
    "rawProviderResponsesInLogsByDefault": false,
    "requiredReceiptFields": [
      "taskId",
      "sourceRef",
      "scopeId",
      "providerId",
      "adapterId",
      "capabilityId",
      "state",
      "startedAt",
      "finishedAt",
      "evidenceRefs"
    ],
    "providerSuccessIsNotProjectGreen": true,
    "exactExecutionClaimRequiresReceipt": true
  },
  "network": {
    "trafficController": "doctrine/cloudflareAirTrafficControllerV1.json",
    "cloudflareIsAiProvider": false,
    "cloudflareMayRouteProviderSelection": false,
    "cloudflareMayGrantGreen": false,
    "cloudflareMayGrantCrown": false
  },
  "driftManagement": {
    "capabilityContractsStableAcrossProviderSwap": true,
    "providerVersionsPinnedOrReceiptBound": true,
    "currentDocsCheckWhenProviderBehaviorMateriallyChanges": true,
    "deprecatedProviderMayBeRemovedWithoutEndUserWorkflowChange": true,
    "newProviderAdmissionRequiresAdapterAudit": true
  },
  "authorityBoundary": {
    "providerMayMerge": false,
    "providerMayPublish": false,
    "providerMayProductionSign": false,
    "providerMayGrantGreen": false,
    "providerMayGrantCrown": false,
    "trafficControllerMayGrantAuthority": false
  },
  "crownStatus": "STOP"
}
