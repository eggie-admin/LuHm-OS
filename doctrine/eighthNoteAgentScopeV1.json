{
  "schema": "luhmOs.eighthNoteAgentScope.v1",
  "status": "PROPOSED_SOURCE_ONLY",
  "authority": "Professor",
  "purpose": "Subdivide a focused AI-agent task into eight scoped notes inside the existing 4/4 interaction rhythm.",
  "parentRhythm": "doctrine/fourBeatInteractionRhythmV1.json",
  "parentArchitecture": "doctrine/jqueryFourLayerArchitectureV1.json",
  "meter": {
    "signature": "4/4",
    "notesPerMeasure": 8,
    "notesPerBeat": 2
  },
  "scopeContract": {
    "required": [
      "taskId",
      "sourceRef",
      "scopeId",
      "goal",
      "inputs",
      "allowedActions",
      "owner",
      "stopCondition",
      "requiredEvidence"
    ],
    "identityLaw": "all providers, mini-agents, auditors and Lum operate on the same taskId/sourceRef/scopeId",
    "noAuthorityFromAlias": true
  },
  "notes": [
    {
      "note": 1,
      "beat": 1,
      "name": "hearProfessorGoal",
      "owner": "lum",
      "output": "userGoal"
    },
    {
      "note": 2,
      "beat": 1,
      "name": "bindFocusedScopeAndDelegatedAuthority",
      "owner": "lum",
      "output": "taskScope"
    },
    {
      "note": 3,
      "beat": 2,
      "name": "resolveVendorAiCapabilityAndEntitlement",
      "owner": "skuldResearch",
      "output": "verifiedProviderScope"
    },
    {
      "note": 4,
      "beat": 2,
      "name": "routeVendorAiAndFocusedMiniAgentWork",
      "owner": "lum",
      "output": "boundedAgentTasks"
    },
    {
      "note": 5,
      "beat": 3,
      "name": "collectVendorAndMiniAgentCandidates",
      "owner": "taskScopedWorkers",
      "output": "candidateResults"
    },
    {
      "note": 6,
      "beat": 3,
      "name": "goddessAuditThenLumReconcile",
      "owner": "goddessCabinetAndLum",
      "output": "auditedCandidate"
    },
    {
      "note": 7,
      "beat": 4,
      "name": "applyTestAndVerify",
      "owner": "lum",
      "output": "evidenceReceipt"
    },
    {
      "note": 8,
      "beat": 4,
      "name": "reportCloseOrReturnCrown",
      "owner": "lum",
      "output": "ProfessorStatus"
    }
  ],
  "authorityChain": [
    "vendorAiProvider",
    "focusedMiniAgents",
    "goddessAuditors",
    "lumCustomAgentBoss"
  ],
  "scopes": {
    "vendorAiProvider": {
      "authority": "providerCapabilityOnly",
      "may": "produceScopedCandidateOutput",
      "mayNot": "grantAuthorityOrApproveOwnOutput"
    },
    "focusedMiniAgents": {
      "authority": "boundedTaskExecution",
      "maxParallelSupportWorkers": 3,
      "recursiveRecruitment": false
    },
    "goddessAuditors": {
      "agents": [
        "urdDoctorGoddess",
        "belldandySecretary",
        "skuldResearch"
      ],
      "authority": "domainAuditAndEvidenceReview"
    },
    "lumCustomAgentBoss": {
      "authority": "taskScopedCrownDelegationAfterExplicitProfessorFinalBossInvocation",
      "may": [
        "route",
        "mutateWithinScope",
        "test",
        "promoteWithinScope",
        "deployWithinScope"
      ],
      "reportsTo": "Professor"
    }
  },
  "finalBossDelegation": {
    "trigger": "explicitProfessorInvocationOfFinalBoss",
    "delegate": "lum",
    "purpose": "make the AI provider, agent, mini-agent and goddess audit workflow working for the active AI milestone",
    "permittedActions": [
      "configureAlreadyEntitledProviders",
      "activateRegisteredTaskScopedAgents",
      "applyBoundedAiWorkflowMutations",
      "runAuditsAndTests",
      "promoteGreenAiScopeChanges",
      "deployVerifiedAiScopeChanges"
    ],
    "limits": [
      "activeTaskEnvelopeOnly",
      "noNewPaidSpend",
      "noCredentialDisclosureOrSecretAccessOutsideAuthorizedConnector",
      "noPublicPublication",
      "noUnrelatedCreativeOrAndroidMutation"
    ],
    "executionLoop": [
      "SANITY_CHECK",
      "AUDIT",
      "INGEST",
      "MUTATE",
      "TEST",
      "APPLY",
      "CONTINUE",
      "DEPLOY"
    ],
    "stopConditions": [
      "missingProviderEntitlement",
      "missingRequiredCredential",
      "unresolvedRED",
      "scopeBoundaryReached",
      "externalPublicationBoundary"
    ],
    "crownReturn": "returnDelegatedCrownToProfessorAtMilestoneCompletionOrStop"
  },
  "evidenceLaw": {
    "roster": "doctrine/agentSystemDeploymentV1.json",
    "registeredDoesNotMeanLive": true,
    "eachRequiredWorkerNeedsReceipt": true,
    "missingRequiredDisposition": "BLOCKED",
    "fullAgentApprovalIsEvidenceBackedNotSelfApproval": true,
    "lumReconcilesAllDispositions": true,
    "noHiddenAsyncExecution": true
  },
  "promotion": false,
  "crownStatus": "STOP"
}
