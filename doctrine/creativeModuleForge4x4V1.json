  "lanes": [
    {
      "id": "rulesRoleplay",
      "engine": "javascript",
      "input": [
        "originalRulePack",
        "declaredSrdReference"
      ],
      "output": [
        "diceOutcome",
        "encounterReceipt"
      ],
      "noVendorGameRulesCopy": true
    },
    {
      "id": "worldModules",
      "engine": "javascriptGodot",
      "input": [
        "originalQuest",
        "safeSceneDsl",
        "factionCatalog"
      ],
      "output": [
        "modulePreview",
        "sceneHandoff"
      ],
      "noEval": true
    },
    {
      "id": "artAvatars",
      "engine": "blenderGimpLive2dReview",
      "input": [
        "licensedPsdLayers",
        "originalSvg",
        "approvedDazReference"
      ],
      "output": [
        "blenderRetargetPlan",
        "godotImportPlan"
      ],
      "noPrivateModelsInGit": true
    },
    {
      "id": "communitySignals",
      "engine": "pythonGit",
      "input": [
        "boundedAtomRssBytes",
        "githubReference",
        "nexusMetadataReference",
        "emulatorResearchReference"
      ],
      "output": [
        "sourceDigest",
        "rightsHold"
      ],
      "noAutoFetch": true
    }
  ],
  "phases": [
    {
      "id": "R1",
      "state": "sourceIdentity",
      "required": "exactGitSourceAndAuthor"
    },
    {
      "id": "R2",
      "state": "rightsReview",
      "required": "licenseAndPerAssetProvenance"
    },
    {
      "id": "R3",
      "state": "offlineTest",
      "required": "hostileBoundedParserAndOriginalFixture"
    },
    {
      "id": "R4",
      "state": "ownerRelease",
      "required": "exactTargetHumanApprovalAndRuntimeProof"
    }
  ],
