  "scriptLanguage": {
    "name": "Premonition Scene DSL",
    "version": 1,
    "representation": "JSON_ONLY_NO_EVAL",
    "moduleTypes": [
      "quest",
      "encounter",
      "dialogue"
    ],
    "commands": [
      "say",
      "check",
      "grant",
      "goto"
    ],
    "allowedDice": "NdM+/-K bounded",
    "randomSource": "seededDeterministicForSyntheticTestOnly",
    "noUntrustedCode": true,
    "noImports": true,
    "noFileSystemOps": true,
    "noNetworkOps": true,
    "noShellOps": true,
    "noUserScripts": true,
    "noRemotePackageExecution": true
  },
  "rss": {
    "formats": [
      "rss2",
      "atom"
    ],
    "maxBytes": 65536,
    "maxEntries": 32,
    "maxTitleChars": 160,
    "secureNoDtd": true,
    "secureNoEntity": true,
    "secureNoNetwork": true,
    "allowedLinkSchemes": [
      "https"
    ],
    "noSchedulerAttached": true,
    "manualUserProvidedXmlOnly": true,
    "noScrape": true
  },
  "mods": {
    "nexus": "AUTHOR_FILE_PERMISSIONS_REQUIRED",
