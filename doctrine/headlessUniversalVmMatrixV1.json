  "architecture": {
    "client": "Existing ChatGPT seven-visual-plane cockpit, mobile Android thin client; not local root/GDM/server",
    "api": "Existing MCP harness and private optional FastAPI planner; no direct privileged camera/VM/SSH endpoint in browser",
    "control": "Lum same exact taskId/sourceRef/scopeId with one read-only evidence lane",
    "host": "Physical Pi OS Lite/Debian/Ubuntu ARM64 or x86_64 minimal Linux kernel; no forced universal kernel image",
    "guest": "libvirt/QEMU abstraction optional, gated KVM support or slower TCG cross-CPU emulation",
    "workload": "isolated RetroArch/Kodi/optional Plex/OBS/MediaPipe/FFmpeg units outside minimal host",
    "storage": "SQLite metadata receipts, Google Drive for approved durable binaries, snapshots keyed by SHA256 and separate signing proof",
    "network": "default deny, no raw hypervisor/SQL/camera/OBS WebSocket ports published",
    "update": "existing R1-R4 SHA/HMAC/AES-GCM candidate gate plus separate publisher signature and rollback; never auto install"
  },
  "dimensions": {
    "lanes": 4,
    "stages": [
      "R1",
      "R2",
      "R3",
      "R4"
    ],
    "cells": 16,
    "meter": "hearResolveActVerify"
  },
  "matrix": [
    {
      "lane": "foundation",
      "title": "Headless host + kernel",
      "boundary": "Physical Pi/ARM64 or x86_64 Linux host retains kernel, firmware and drivers; VM never replaces host kernel",
      "technology": [
        "Raspberry Pi OS Lite",
        "Debian/Ubuntu LTS",
        "Linux namespaces/cgroups",
        "systemd"
      ],
      "licensePolicy": "Distribution, kernel and package licenses reviewed per component",
      "stages": [
        {
          "id": "foundationR1",
          "stage": "R1",
          "tier": 0,
          "objective": "Verify observed arch, kernel, OS, boot firmware provenance, exact source SHA",
          "requiredEvidence": [
            "archReceipt",
            "kernelReceipt",
            "sourceRef"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
          "id": "foundationR2",
          "stage": "R2",
          "tier": 1,
          "objective": "Audit local-only services, rootless role, SSH host-key pinning, minimal device ACLs",
          "requiredEvidence": [
            "serviceInventory",
            "networkAclReceipt",
            "sshHostKeyAttestation"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
          "id": "foundationR3",
          "stage": "R3",
          "tier": 2,
          "objective": "Prove CPU/RAM/cgroup/thermal/storage limits and recoverable configuration snapshot",
          "requiredEvidence": [
            "resourceBenchmark",
            "snapshotDigest",
            "rollbackReceipt"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
          "id": "foundationR4",
          "stage": "R4",
          "tier": 3,
          "objective": "Review owner host changes, signing/update authority and physical Pi boot proof",
          "requiredEvidence": [
            "ownerReceipt",
            "physicalBootReceipt",
            "ciExactSha"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        }
      ]
    },
    {
      "lane": "virtualization",
      "title": "VM and emulation substrate",
      "boundary": "Per-architecture libvirt/QEMU feature probing; KVM only where supported; TCG CPU emulation fallback is slower",
      "technology": [
        "libvirt",
        "QEMU",
        "KVM",
        "virtio",
        "QEMU TCG"
      ],
      "licensePolicy": "GPL/LGPL component review before distribution",
      "stages": [
        {
          "id": "virtualizationR1",
          "stage": "R1",
          "tier": 0,
          "objective": "Distinguish host aarch64/x86_64, KVM availability and QEMU TCG compatibility",
          "requiredEvidence": [
            "cpuArch",
