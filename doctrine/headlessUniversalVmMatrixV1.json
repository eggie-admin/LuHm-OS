          "tier": 2,
          "objective": "Compare direct-play vs transcoding, ARM64 vs x86 emulation, JIT/TCG CPU budget and netplay isolation",
          "requiredEvidence": [
            "latencyBench",
            "jitPolicy",
            "mediaProof",
            "networkIsolationReceipt"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
