          "stage": "R4",
          "tier": 3,
          "objective": "Release only rights-cleared, separately approved core/content bundles or demo media",
          "requiredEvidence": [
            "rightsReview",
            "ownerApproval",
            "exactArtifactDigest"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        }
      ]
