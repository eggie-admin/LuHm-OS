            "qemuCapabilities"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
          "id": "virtualizationR2",
          "stage": "R2",
          "tier": 1,
          "objective": "Define unprivileged libvirt session, deny network exposure and USB passthrough by default",
          "requiredEvidence": [
            "libvirtModeReceipt",
            "isolationPolicy",
            "deviceAclReview"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
          "id": "virtualizationR3",
          "stage": "R3",
          "tier": 2,
          "objective": "Proof isolated test guest boot, bounded resource meters, snapshot restore and verified artifacts",
          "requiredEvidence": [
            "guestBootProof",
            "resourceBench",
            "snapshotRestoreDigest"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        },
        {
          "id": "virtualizationR4",
          "stage": "R4",
          "tier": 3,
          "objective": "Review signed guest image provenance, explicit target and rollback before VM changes",
          "requiredEvidence": [
            "imageSignature",
            "ownerReceipt",
            "rollbackProof"
          ],
          "localProofState": "UNKNOWN",
          "liveExecution": false
        }
      ]
    },
    {
      "lane": "emulationMedia",
      "title": "Retro + media sandbox",
      "boundary": "RetroArch/libretro cores, Kodi and Plex are guest workloads or separate services, never privileged kernel modules",
      "technology": [
        "RetroArch",
        "libretro API",
        "Kodi JSON-RPC",
        "Plex optional",
        "FFmpeg"
      ],
      "licensePolicy": "RetroArch GPLv3; individual core licenses vary; Kodi copyleft; Plex proprietary; no copyrighted BIOS/ROM distribution",
      "stages": [
        {
          "id": "emulationMediaR1",
          "stage": "R1",
