{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eggiebagelface.art/schemas/jrpgAiProposal.schema.json",
  "title": "LuHm JRPG AI Proposal",
  "description": "Advisory AI output for JRPG/dating-sim content. Godot validates and owns all authoritative state changes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "speakerId",
    "dialogue",
    "emotion",
    "animationCue",
    "portraitExpression",
    "voiceStyle",
    "intentTag",
    "suggestedRelationshipDelta",
    "suggestedFlags",
    "sceneSuggestions",
    "warnings",
    "provenance"
  ],
  "properties": {
    "speakerId": {"type": "string", "maxLength": 128},
    "dialogue": {"type": "string", "maxLength": 4000},
    "emotion": {"type": "string", "maxLength": 64},
    "animationCue": {"type": "string", "maxLength": 128},
    "portraitExpression": {"type": "string", "maxLength": 128},
    "voiceStyle": {"type": "string", "maxLength": 128},
    "intentTag": {
      "type": "string",
      "enum": ["banter", "bond", "quest", "route", "combat", "ambient", "cutscene", "system"]
    },
    "suggestedRelationshipDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "affection": {"type": "integer", "minimum": -10, "maximum": 10},
        "friendship": {"type": "integer", "minimum": -10, "maximum": 10},
        "trust": {"type": "integer", "minimum": -10, "maximum": 10},
        "rivalry": {"type": "integer", "minimum": -10, "maximum": 10},
        "jealousy": {"type": "integer", "minimum": -10, "maximum": 10},
        "routeAffinity": {"type": "integer", "minimum": -10, "maximum": 10}
      }
    },
    "suggestedFlags": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 128},
      "uniqueItems": true
    },
    "sceneSuggestions": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 512}
    },
    "warnings": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 512}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "requestId"],
      "properties": {
        "provider": {"type": "string", "enum": ["gemini", "gemma", "ollama", "other", "UNKNOWN"]},
        "model": {"type": "string", "maxLength": 128},
        "requestId": {"type": "string", "maxLength": 256}
      }
    }
  }
}
