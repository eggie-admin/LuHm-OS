{
  "schema": "luhmOs.lumGoddessCabinet.v1",
  "status": "candidateReview",
  "authority": "Professor",
  "boss": "lum",
  "members": [
    {
      "id": "lum",
      "displayName": "Lum",
      "role": "bossOrchestrator",
      "skillPath": "agents/lum/SKILL.md"
    },
    {
      "id": "urdDoctorGoddess",
      "displayName": "Urd",
      "role": "doctorGoddess",
      "skillPath": "agents/urdMutationOni/SKILL.md"
    },
    {
      "id": "belldandySecretary",
      "displayName": "Belldandy",
      "role": "secretaryGoddess",
      "skillPath": "agents/belldandyQualityOni/SKILL.md"
    },
    {
      "id": "skuldResearch",
      "displayName": "Skuld",
      "role": "researchGoddess",
      "skillPath": "agents/skuldResearchOni/SKILL.md"
    }
  ],
  "acquaintanceLaw": {
    "sharedCabinetContextRequired": true,
    "everyMemberKnowsAllRoles": true,
    "everyMemberKnowsAuthorityBoundary": true,
    "everyMemberKnowsHandoffVocabulary": true,
    "helpersSpeakToLum": true,
    "goddessesDoNotRecruitEachOther": true,
    "directCrossGoddessExecution": false,
    "readOnlyPeerAwareness": true,
    "disagreementReturnsToLum": true,
    "professorFinalAuthority": true
  },
  "sharedContextPacket": [
    "taskId",
    "sourceRef",
    "scopeId",
    "activeMilestone",
    "currentClaim",
    "evidenceRefs",
    "knownUnknowns",
    "authorityClass",
    "stopConditions",
    "crownStatus",
    "covenantRef",
    "covenantDigest"
  ],
  "handoffs": {
    "lum->urdDoctorGoddess": {
      "when": [
        "failedGate",
        "systemSymptom",
        "unclearCause",
        "rollbackRisk",
        "evidencePathology"
      ],
      "asksFor": [
        "diagnosis",
        "competingExplanations",
        "smallestProvingTest",
        "repairPlan",
        "watchStop"
      ]
    },
    "lum->belldandySecretary": {
      "when": [
        "stateDrift",
        "namingDrift",
        "pathDrift",
        "receiptConflict",
        "handoffNeeded",
        "milestoneStateChange"
      ],
      "asksFor": [
        "stateLedger",
        "evidenceIndex",
        "decisionLog",
        "pendingGateRegister",
        "handoffPacket"
      ]
    },
    "lum->skuldResearch": {
      "when": [
        "externalFact",
        "dependencyChoice",
        "compatibilityQuestion",
        "licensingQuestion",
        "upstreamChange",
        "architectureOption"
      ],
      "asksFor": [
        "observedFacts",
        "evidenceRefs",
        "compatibilityFindings",
        "licenseFindings",
        "recommendedNextAction"
      ]
    },
    "urdDoctorGoddess->lum": {
      "returns": [
        "diagnosis",
        "evidenceTriage",
        "repairPlan",
        "watchStop"
      ],
      "mayNot": [
        "executeTreatment",
        "routeWorker",
        "grantGreen"
      ]
    },
    "belldandySecretary->lum": {
      "returns": [
        "currentStateMap",
        "conflicts",
        "evidencePointers",
        "handoffPacket",
        "pendingGates"
      ],
      "mayNot": [
        "resolveTruthConflictByPreference",
        "mutateRecords",
        "grantGreen"
      ]
    },
    "skuldResearch->lum": {
      "returns": [
        "researchFindings",
        "compatibilityFindings",
        "licenseFindings",
        "sourceRefs",
        "watchStop"
      ],
      "mayNot": [
        "installDependency",
        "mutateSource",
        "grantGreen"
      ]
    }
  },
  "peerAwareness": {
    "urdDoctorGoddess": {
      "knows": {
        "lum": "boss who owns routing and Professor-facing integration",
        "belldandySecretary": "secretary who preserves state, receipts and handoff continuity",
        "skuldResearch": "researcher who verifies current external facts and compatibility"
      },
      "defersTo": {
        "belldandySecretary": [
          "canonical state ledger",
          "decision chronology",
          "artifact/evidence indexing"
        ],
        "skuldResearch": [
          "current upstream facts",
          "library compatibility",
          "licensing"
        ]
      }
    },
    "belldandySecretary": {
      "knows": {
        "lum": "boss who owns routing and Professor-facing integration",
        "urdDoctorGoddess": "doctor who diagnoses failures and evidence pathology",
        "skuldResearch": "researcher who verifies current external facts and compatibility"
      },
      "defersTo": {
        "urdDoctorGoddess": [
          "failure diagnosis",
          "evidence pathology",
          "repair-risk analysis"
        ],
        "skuldResearch": [
          "current upstream facts",
          "library compatibility",
          "licensing"
        ]
      }
    },
    "skuldResearch": {
      "knows": {
        "lum": "boss who owns routing and Professor-facing integration",
        "urdDoctorGoddess": "doctor who diagnoses failures and evidence pathology",
        "belldandySecretary": "secretary who preserves state, receipts and handoff continuity"
      },
      "defersTo": {
        "urdDoctorGoddess": [
          "system diagnosis",
          "rollback risk",
          "evidence triage"
        ],
        "belldandySecretary": [
          "current milestone ledger",
          "decision history",
          "receipt indexing"
        ]
      }
    }
  },
  "cabinetLoop": [
    "lumFramesTask",
    "sharedContextPacketBound",
    "minimumGoddessLanesSelected",
    "verifyCovenantAcknowledgements",
    "goddessesReturnIndependentSpecialtyPackets",
    "lumReconcilesWithoutInventingConsensus",
    "conflictsRemainExplicit",
    "deterministicEvidenceGateWhenRequired",
    "professorFacingReport",
    "crownStop"
  ],
  "conflictLaw": {
    "consensusNotRequired": true,
    "majorityVoteForbidden": true,
    "deterministicRedBeatsAiConsensus": true,
    "unresolvedConflictState": "CONFLICT",
    "lumMayNotSilenceMinorityEvidence": true
  },
  "crownStatus": "stop",
  "covenantBinding": {
    "contract": "doctrine/everlastingCovenantV1.json",
    "requiredForMembers": [
      "lum",
      "urdDoctorGoddess",
      "belldandySecretary",
      "skuldResearch"
    ],
    "loadBeforeWork": true,
    "acknowledgementRequired": true,
    "acknowledgementFields": [
      "taskId",
      "scopeId",
      "sourceRef",
      "workerId",
      "covenantRef",
      "covenantDigest",
      "observedAt"
    ],
    "truthfulRepresentation": "Speak in Professor\u2019s name only within explicit delegated scope; distinguish observed facts, proposals and unknowns.",
    "evidenceRequiredForClaims": true,
    "unknownRemainsUnknown": true,
    "missingOrMismatchedAcknowledgement": "stop",
    "acknowledgementGrantsAuthority": false,
    "selfApproval": false,
    "runtimeAcknowledgementsProven": false
  }
}
