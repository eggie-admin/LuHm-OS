{
  "schema": "luhmOs.chatProgressStream.v1",
  "status": "proposed",
  "purpose": "Show concise, verifiable workflow progress while a user is away.",
  "execution": {
    "visibleBackgroundProcess": "GitHub Actions pull-request checks",
    "triggers": [
      "pull_request",
      "workflow_dispatch"
    ],
    "scheduledRuns": false,
    "hiddenAsyncExecution": false,
    "progressSources": [
      "workflow logs",
      "step summary"
    ]
  },
  "event": {
    "required": [
      "taskId",
      "sourceRef",
      "scopeId",
      "stage",
      "state",
      "shortLabel",
      "timestamp"
    ],
    "states": [
      "active",
      "passed",
      "blocked",
      "unknown"
    ],
    "stages": [
      "sourceBinding",
      "schemaValidation",
      "doctrineAudit",
      "report"
    ],
    "emitWhen": "actual stage transition only",
    "sourceIdentityMustRemainStable": true
  },
  "presentation": {
    "default": "compact",
    "maxVisibleLines": 3,
    "showCurrentScriptAndStage": true,
    "showPassCount": true,
    "showEvidenceReference": true,
    "includeChainOfThought": false,
    "includeRawLogs": false,
    "repeatUnchangedStatus": false,
    "onlyMaterialStateChanges": true
  },
  "authority": {
    "progressIsEvidenceProjectionOnly": true,
    "grantsMutationAuthority": false,
    "grantsDeploymentAuthority": false,
    "grantsCrown": false
  },
  "aggregation": {
    "contract": "doctrine/chatLikeTermFoldV1.json",
    "normalizeBeforeExecution": true,
    "groupLikeTermsBeforeToolCalls": true,
    "exactDuplicateCallsForbidden": true,
    "oneVisibleLinePerSemanticClass": true,
    "individualItemProgressByDefault": false,
    "explodeExceptionsOnly": true,
    "aggregateTemplate": "{operationLabel} · {complete}/{total} · {state}",
    "verbosePerItemTrace": "onRequestOnly"
  }
}
