{
  "schema": "luhmOs.storageTopology.v1",
  "status": "candidateReview",
  "authority": "Professor",
  "sourceLaw": "AI proposes. Policy authorizes. CI proves. Human promotes.",
  "primeLaw": "databases point to files; databases do not become the file server",
  "linuxMetaphor": {
    "semanticDb": "/var/lib/luhm/contextDb",
    "sourceDb": "/var/lib/luhm/sourceDb",
    "fileServer": "/srv/luhm",
    "runtimeMount": "/mnt/device",
    "ephemeral": [
      "/var/cache/luhm",
      "/tmp/luhm"
    ]
  },
  "roles": {
    "openAi": {
      "role": "semanticDb",
      "purpose": "conversation context, agent state, decisions, references, semantic indexing",
      "sourceAuthority": false,
      "durableBinaryStorage": false,
      "secretStorage": false
    },
    "github": {
      "role": "sourceDb",
      "purpose": "source code, commits, branches, pull requests, workflows, receipts, hashes, artifact pointers",
      "canonicalSourceAuthority": true,
      "durableBinaryStorage": false,
      "releaseAndCiArtifacts": "ephemeralTransportOrBuildCacheOnly",
      "binaryArchiveAuthority": false
    },
    "googleDrive": {
      "role": "fileServer",
      "purpose": "durable APKs, ZIPs, media, manuals, snapshots, recovery bundles, exports, large build artifacts",
      "canonicalBinaryStorage": true,
      "sourceAuthority": false,
      "promotionAuthority": false
    },
    "androidDevice": {
      "role": "runtimeMount",
      "purpose": "installed runtime, bounded cache, physical-device proof receipts",
      "durableBinaryStorage": false,
      "sourceAuthority": false,
      "promotionAuthority": false
    },
    "chatGptLibrary": {
      "role": "workingReviewLayer",
      "purpose": "private art, previews, reference snapshots and deliverable handoffs; preserves file identity and provenance",
      "canonicalSourceAuthority": false,
      "canonicalBinaryStorage": false,
      "promotionAuthority": false,
      "automaticallySynchronizedWithDrive": false,
      "mayReplaceDriveMaster": false
    }
  },
  "artifactRecordRequired": [
    "artifactId",
    "filename",
    "sha256",
    "sourceRef",
    "buildRun",
    "createdAt",
    "driveFileIdOrLogicalRef",
    "mimeType",
    "sizeBytes",
    "status"
  ],
  "artifactLifecycle": [
    "buildInEphemeralWorkspace",
    "hashAndVerify",
    "copyDurableBinaryToGoogleDrive",
    "recordDrivePointerAndDigestInGitHub",
    "useTransportCopyOnlyWhenNeeded",
    "garbageCollectEphemeralCopiesAfterReceipt"
  ],
  "rules": {
    "githubReleaseMayBeTransport": true,
    "githubReleaseIsDurableArchive": false,
    "ciArtifactMayBeBuildCache": true,
    "ciArtifactIsDurableArchive": false,
    "driveCopyRequiredForDurableArtifact": true,
    "databaseMayStoreBinaryPointer": true,
    "databaseMayStoreCanonicalBinary": false,
    "privateDriveIdsStayOutOfPublicDoctrine": true,
    "artifactDigestRequired": true,
    "unknownStorageLocationIsNotGreen": true,
    "chatGptLibraryWorkingCopiesAllowed": true,
    "chatGptLibraryMayReplaceDriveMaster": false,
    "chatGptLibraryAutomaticSyncProven": false,
    "chatGptLibraryIsCanon": false
  },
  "crownStatus": "stop",
  "workingCopyContinuity": {
    "contractScope": "sourceRoleReconciliationOnly",
    "existingLibraryFolders": [
      "Brand and Canon",
      "Art and Previews",
      "Exports",
      "godotAssets"
    ],
    "preserveExistingFileIds": true,
    "preserveEditableOriginals": true,
    "libraryFileEvidenceSeparateFromDriveMaster": true,
    "noAutomaticCopyOrBackupClaims": true,
    "sourceValidationIsNotRuntimeSync": true
  }
}
