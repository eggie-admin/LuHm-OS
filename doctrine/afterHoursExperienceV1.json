{
  "schema": "luhmOs.afterHoursExperience.v1",
  "status": "SOURCE_CONFIGURED_CANDIDATE",
  "authority": "Professor",
  "purpose": "A deliberately entered, visually distinct adult goth MUD entertainment shell inside the LuHm ChatGPT cockpit while normal ChatGPT remains literal outside it.",
  "modeBoundary": {
    "defaultMode": "normalChat",
    "entryCommand": "AFTER HOURS",
    "pauseCommand": "PAUSE",
    "resumeCommand": "RESUME",
    "exitCommand": "EXIT",
    "explicitEntryRequired": true,
    "normalChatNeverAutoEnters": true,
    "exitReturnsToNormalChat": true,
    "realWorldRequestPausesFiction": true
  },
  "presentation": {
    "title": "LuHm After Hours",
    "subtitle": "tiny goth MUD",
    "theme": "adultAnimeGothNightlife",
    "visuallyDistinctFromNormalChat": true,
    "shellStyle": "terminalMud",
    "commandBar": [
      "LOOK",
      "TALK",
      "GO",
      "FLIRT",
      "DRINK",
      "INVENTORY",
      "STATS",
      "CHAOS",
      "C"
    ],
    "systemCommands": [
      "AFTER HOURS",
      "PAUSE",
      "RESUME",
      "EXIT"
    ]
  },
  "fictionBoundary": {
    "allCharactersAdults": true,
    "fictionalSceneStateCannotMutateRealWorld": true,
    "roleplayCannotGrantAuthority": true,
    "gameGreenCannotGrantSystemGreen": true,
    "noImplicitCarryoverIntoNormalChat": true,
    "realWorldToolRequestsRequireNormalChatContext": true
  },
  "session": {
    "continuity": "conversationScoped",
    "stateLabels": [
      "OUTSIDE",
      "ACTIVE",
      "PAUSED"
    ],
    "initialState": "OUTSIDE",
    "freeformNaturalLanguageInput": true,
    "oldMudVerbInput": true
  },
  "authorityBoundary": {
    "readOnlyPresentation": true,
    "mutationAuthority": false,
    "greenAuthority": false,
    "publicationAuthority": false,
    "crownAuthority": false
  },
  "promotion": false,
  "crownStatus": "STOP",
  "fastMudTurn": {
    "status": "CANDIDATE_SOURCE_ONLY",
    "intent": "fast responsive conversational dungeon master, not a heavyweight UI",
    "chatEntryPrefixes": [
      "IN SCENE",
      "AFTER HOURS"
    ],
    "chatExitPrefixes": [
      "OOC",
      "IRL",
      "OUT OF CHARACTER"
    ],
    "commands": [
      "LOOK",
      "TALK",
      "INSPECT",
      "GO",
      "TAKE",
      "USE",
      "INVENTORY",
      "STATS",
      "CHAOS",
      "ART",
      "C"
    ],
    "pacing": {
      "actionFirst": true,
      "targetWordsPerRoutineTurn": 120,
      "maxWordsPerRoutineTurn": 150,
      "maxSuggestedChoices": 3,
      "allowNaturalSpeech": true,
      "resolveOneActionPerTurn": true,
      "noRoutineTitleCards": true,
      "noRoutineQuestWidgets": true,
      "showQuestInventoryOnlyWhenChangedOrRequested": true,
      "noRepeatedLocationRecaps": true,
      "noForcedCommandMenus": true
    },
    "art": {
      "textTurnsNeverBlockedOnImageGeneration": true,
      "drawOnExplicitArtCommandOrMeaningfulSceneReveal": true,
      "doNotSearchForImagesOnRoutineActions": true,
      "noPretendImagesOrRuntimeScreenshots": true,
      "keepTextDialogueOutsideRenderedArt": true
    },
    "continuity": {
      "preserveConversationScopedRoomAndCharacterState": true,
      "preserveCluesAndInventory": true,
      "noFakePersistentSaveOutsideConversation": true,
      "showNextPlayableBeatWithoutAskingSetupQuestions": true
    },
    "boundaries": {
      "oocStopsSceneImmediately": true,
      "storyActionsNeverInvokePrivilegedTools": true,
      "sourceRuleDoesNotProveLiveHostImplementation": true,
      "roleplayNeverGrantsCrown": true
    }
  }
}
