      "triggers": [
        "check",
        "inspect",
        "audit",
        "status",
        "system"
      ],
      "stop": "Report evidence and next justified action."
    },
    "operate": {
      "tier": 2,
      "lumStates": [
        "INTAKE",
        "RESOLVE",
        "ROUTE",
        "OBSERVE",
        "MUTATE",
        "VERIFY",
        "ADJUDICATE",
        "REPORT"
      ],
      "allowedModes": [
        "apply",
        "test",
        "all"
      ],
