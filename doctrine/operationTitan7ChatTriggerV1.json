  "routing": {
    "ambiguousTrigger": "inspect",
    "higherTierIncludesLowerTierChecks": true,
    "phraseMatchingIsNotAuthority": true,
    "directQuestionBypassesMesh": true,
    "allMapsTo": "operate",
