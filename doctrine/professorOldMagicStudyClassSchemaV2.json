{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "luhm.studyMesh.class.v2",
  "title": "LuHm Study Mesh Class v2",
  "type": "object",
  "required": [
    "schemaId",
    "classId",
    "state",
    "topic",
    "principle",
    "studyBuddies",
    "factPolicy",
    "transport"
  ],
  "properties": {
    "schemaId": {
      "const": "classV2"
    },
    "classId": {
      "type": "string"
    },
    "state": {
      "enum": [
        "draft",
        "study",
        "review",
        "greenCandidate",
        "parked"
      ]
    },
    "topic": {
      "type": "string"
    },
    "principle": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "studyBuddies": {
      "type": "array",
      "items": {
        "enum": [
          "lum",
          "urdDoctorGoddess",
          "belldandySecretary",
          "skuldResearch"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "factPolicy": {
      "type": "object"
    },
    "transport": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
