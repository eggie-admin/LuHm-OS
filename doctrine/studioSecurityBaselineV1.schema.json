        "render": {
          "type": "string",
          "minLength": 10
        },
        "github": {
          "type": "string",
          "minLength": 10
        },
        "copilot": {
          "type": "string",
          "minLength": 10
        },
        "openAi": {
          "type": "string",
          "minLength": 10
        },
        "sql": {
