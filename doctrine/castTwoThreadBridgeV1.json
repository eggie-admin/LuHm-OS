  "canonicalStates": [
    "sanityCheck",
    "audit",
    "ingest",
    "mutation",
    "test",
    "apply",
    "continue",
    "deploy"
  ],
  "professorLanguage": [
    {
      "says": "sanity check",
      "mapsTo": [
        "sanityCheck"
      ]
    },
    {
      "says": "hard audit",
      "mapsTo": [
        "audit",
        "ingest"
      ]
    },
    {
      "says": "adjust/mutate",
      "mapsTo": [
        "mutation"
      ]
    },
    {
      "says": "build",
      "mapsTo": [
        "test"
      ],
      "note": "Build/test evidence is required; a plan is not a build."
    },
    {
      "says": "deploy",
      "mapsTo": [
        "apply",
        "continue",
        "deploy"
      ],
      "note": "Proposed-candidate only under current Canon."
    },
    {
      "says": "CAST Bridge test",
      "mapsTo": [
        "postDeployBridgeSmoke"
      ],
      "note": "Separate proof after approved deployment; not one of the eight canonical states."
    }
  ],
  "receiptRules": {
    "requiredIdentity": [
      "taskId",
      "sourceRef",
      "scopeId",
      "stage",
      "evidenceSha256"
    ],
    "sourceRef": "exactLowercase40Hex",
    "artifactDigest": "lowercase64Hex",
    "evidenceFromUserOrUnverifiedAdapter": "UNTRUSTED_CLAIM",
    "stageOrderStrict": true,
    "noSkip": true,
    "onMissing": "HOLD",
    "onDifferentSource": "STOP",
    "onContradiction": "STOP",
    "resumeAcrossChangedSource": false,
    "goalStoredAsHashOnly": true,
    "twoLogicalThreadsDoesNotMeanTwoExecutingAgents": true,
    "noParallelSourceMutators": true,
    "neverClaimGreenFromSourceOnly": true,
    "sameTaskScopeForBothThreads": true,
    "maximumSupportWorkersAfterApprovedRuntime": 3
  },
  "privacy": {
    "noRawGoalInLogs": true,
    "noDeviceSecrets": true,
    "noBrowserApiToken": true,
    "noPublicAdminRoute": true,
    "noPrivateAssetBytes": true
  },
  "runtime": {
    "activeMiniAgents": 0,
    "backgroundWorkers": 0,
    "connectedVm": false,
    "castExecuted": false,
    "productionDeployed": false,
    "clientThreadCreation": false,
    "sharedLiveTimeline": false
  },
  "policy": {
    "companyQuarantine": true,
    "noAutoMerge": true,
    "noAutoDeploy": true,
    "noSelfApproval": true,
    "noNewPaidProvider": true,
    "proposedHostOnlyPrivateFastApi": true,
    "readOnlyMcp": true
  },
  "crownStatus": "STOP",
  "namingSpine": {
