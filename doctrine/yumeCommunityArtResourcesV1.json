{
  "schema": "luhmOs.yumeCommunityArtResources.v1",
  "status": "PROPOSED_SOURCE_ONLY",
  "authority": "Professor",
  "boss": "lum",
  "creativeLead": "yumeArtOni",
  "provenanceLead": "sumi",
  "researchLead": "skuldResearch",
  "diagnosticLead": "urdDoctorGoddess",
  "purpose": "Give Yume a current, fun-first community art resource lane that can discover, shortlist, stage, and hand off rights-cleared assets without confusing free discovery with shippable provenance.",
  "historicalDonor": {
    "commit": "689ddb79982621e44f0eefda761620be0a63ca0b",
    "paths": [
      "assets/community/catalog.json",
      "assets/community/selected-assets.json",
      "tools/communityAssetAudit.py",
      "tools/stageCommunityAssets.py",
      "doctrine/communityAssetMutation-20260926.json"
    ],
    "reusePolicy": "port discipline and metadata patterns only; do not resurrect stale branch wholesale"
  },
  "sourceFamilies": {
    "kenney": {
      "mode": "CC0_FAST_LANE",
      "officialUrl": "https://kenney.nl/assets",
      "licenseClass": "CC0",
      "licenseCheck": "verify included or current official license before staging",
      "preferredFor": ["2d", "ui", "icons", "prototypeTextures", "simple3d"]
    },
    "polyHaven": {
      "mode": "CC0_FAST_LANE",
      "officialUrl": "https://polyhaven.com/",
      "licenseClass": "CC0",
      "licenseCheck": "verify current official asset license before staging",
      "preferredFor": ["hdris", "textures", "materials", "3dEnvironmentProps"]
    },
    "godotAssetStore": {
      "mode": "PER_ASSET_REVIEW",
      "officialUrl": "https://store.godotengine.org/",
      "licenseClass": "PER_ASSET",
      "licenseCheck": "record exact listed license and upstream repository license",
      "preferredFor": ["godotTools", "shaders", "2d", "3d", "editorHelpers"],
      "executableCodeRequiresSeparateReview": true
    },
    "openGameArt": {
      "mode": "PER_ASSET_REVIEW",
      "officialUrl": "https://opengameart.org/",
      "licenseClass": "PER_ASSET",
      "licenseCheck": "record exact asset license, attribution obligations, share-alike implications, and author/source metadata",
      "preferredFor": ["2d", "pixel", "textures", "audio", "ui"]
    }
  },
  "discoveryLaw": [
    "discovery_metadata_is_not_asset_approval",
    "free_does_not_mean_license_free",
    "no_blind_whole_repository_vendoring",
    "no_runtime_network_asset_downloads",
    "no_unknown_license_assets",
    "no_nc_assets_for_distributable_builds",
    "no_franchise_or_copied_character_art",
    "no_executable_plugin_or_script_ingest_without_separate_code_review",
    "no_public_generative_ai_art_by_default",
    "reference_inspiration_may_not_become_identity_copy"
  ],
  "requiredReceiptFields": [
    "assetId",
    "sourceFamily",
    "sourceUrl",
    "sourceRevisionOrVersion",
    "authorOrOwnerWhenRequired",
    "license",
    "licenseUrlOrFile",
    "attributionTextWhenRequired",
    "sourceHash",
    "contentLane",
    "publicAllowed",
    "assetRole",
    "destinationFamily",
    "professorReviewState"
  ],
  "roles": {
    "yumeArtOni": [
      "searchAndShortlist",
      "artDirectionMatch",
      "sceneKitComposition",
      "funPrototypeTaskCards",
      "godotHandoffPlan"
    ],
    "sumi": [
      "sourceIdentity",
      "licenseAndProvenanceReceipt",
      "hashAndDerivativeLineage",
      "publicEligibilityCheck"
    ],
    "skuldResearch": [
      "currentLicenseAndCompatibilityCheck",
      "sourceFamilyResearch",
      "upstreamChangeDetection"
    ],
    "urdDoctorGoddess": [
      "contradictionAndContaminationReview",
      "falseGreenChallenge",
      "rollbackRisk"
    ]
  },
  "funPrototype": {
    "enabled": true,
    "defaultOutputs": [
      "weirdPropShortlist",
      "barAndCoffeeHouseSetDress",
      "detroitIndustrialSetDress",
      "neonRiverwalkBits",
      "pixelPetAndUiCandidates",
      "ambientAndSfxCandidates",
      "godotReadyPrototypeKit"
    ],
    "maxVisibleSuggestionsPerPass": 8,
    "canonPromotion": false,
    "publicationAuthority": false,
    "runtimeProofRequiredAfterImport": true
  },
  "storageLaw": {
    "driveStoresDurableBinaryBytes": true,
    "githubStoresSourceHashesReceiptsAndLogicalPointers": true,
    "publicDoctrineStoresNoPrivateDriveIds": true,
    "similarAssetsAreNotDeletedByNameOnly": true
  },
  "godotLaw": {
    "assetPrepIsNotImportProof": true,
    "importIsNotRuntimeProof": true,
    "runtimeSmokeIsNotPhysicalDeviceProof": true,
    "targetDevicePerformanceRequiresReceipt": true
  },
  "crownStatus": "STOP",
  "promotion": false
}
