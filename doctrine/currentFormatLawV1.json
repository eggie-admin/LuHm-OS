{
  "schema": "luhmOs.currentFormatLaw.v1",
  "status": "PROPOSED_CANON_LAW",
  "authority": "Professor",
  "purpose": "Define current source formatting and implementation rules while preserving legacy artifacts for provenance.",
  "doctrineNaming": {
    "fileBasenames": "lowerCamelHump",
    "jsonKeys": "lowerCamelHump",
    "machineIdentifiers": "lowerCamelHump",
    "nonConformingCurrentDoctrine": "legacyArtifact"
  },
  "aiManifestInstances": {
    "format": "json",
    "instanceFilenameStyle": "kebab-case.json",
    "schemaMustBeCurrent": true,
    "nonKebabInstanceFilename": "legacyArtifact",
    "nonCurrentSchema": "legacyArtifact"
  },
  "implementationLanguage": {
    "controlPlane": "python3",
    "auditAndOrchestration": "python3",
    "nonPythonControlPlaneCode": "legacyArtifact",
    "platformAdapterException": {
      "allowed": true,
      "languages": ["gdscript","kotlin","javascript","html","css","shell","gradle"],
      "law": "platform adapters may remain current only when required by Godot Android Web UI or build transport and may not own doctrine AI authority or source truth"
    }
  },
  "legacyPolicy": {
    "deleteAutomatically": false,
    "rewriteHistoricalReceipts": false,
    "mayReadAsEvidence": true,
    "mayOwnCurrentAuthority": false
  },
  "crownStatus": "STOP"
}
