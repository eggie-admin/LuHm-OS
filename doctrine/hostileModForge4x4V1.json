  "lanes": [
    {
      "id": "hostDisplay",
      "scope": "OS host, headless renderer, Wayland vs optional Xwayland, no X11 root/admin dependency",
      "test": "fixed env whitelist and no display server activation"
    },
    {
      "id": "deviceDebug",
      "scope": "USB VID/PID, Bluetooth services, permission, firmware/driver ownership, log redaction",
      "test": "strict hex identifier parsing; no MAC or USB serial stored"
    },
    {
      "id": "studioMods",
      "scope": "Blender, GIMP, Godot, SDL, FFmpeg, ReShade filters, licensed community mod metadata",
      "test": "source-only manifests and user-authorized read-only analysis"
    },
    {
      "id": "rightsSource",
      "scope": "Git exact refs, vendor license, CC asset attribution, PS1/PS2 ROM patch payload isolation",
      "test": "component rights and diff-only homebrew patch manifests"
    }
  ],
