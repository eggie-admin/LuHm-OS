  "env": {
    "scope": "privateHostProcessOnlyNoSecretsInGitOrLogs",
    "permitted": {
      "LUHM_STAGE": [
        "development",
        "proposed",
        "testing"
      ],
      "LUHM_DISPLAY_BACKEND": [
        "headless",
        "wayland"
      ],
      "LUHM_RENDER_ENGINE": [
        "godot",
        "software"
      ],
      "LUHM_INPUT_MODE": [
        "noDevice",
        "userAuthorized"
      ],
      "LUHM_USB_ENABLED": [
        "off",
        "readOnly"
      ],
      "LUHM_BLUETOOTH_ENABLED": [
        "off",
        "readOnly"
      ],
      "LUHM_DEBUG_PROFILE": [
        "off",
        "redacted"
      ],
      "LUHM_VENDOR_MODE": [
        "metadataOnly"
      ]
    },
    "defaults": {
      "LUHM_STAGE": "proposed",
      "LUHM_DISPLAY_BACKEND": "headless",
      "LUHM_RENDER_ENGINE": "software",
      "LUHM_INPUT_MODE": "noDevice",
      "LUHM_USB_ENABLED": "off",
      "LUHM_BLUETOOTH_ENABLED": "off",
      "LUHM_DEBUG_PROFILE": "off",
      "LUHM_VENDOR_MODE": "metadataOnly"
    },
    "deniedNames": [
      "DISPLAY",
      "XAUTHORITY",
      "LD_PRELOAD",
      "LD_LIBRARY_PATH",
      "PYTHONPATH",
      "PATH",
      "GIT_CONFIG_COUNT",
      "GIT_SSH_COMMAND",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "LUHM_API_KEY",
      "LUHM_PRIVATE_TOKEN"
    ],
    "noEnvInjectionFromModManifest": true,
    "noSecretsReturned": true,
    "noShellFromEnvironment": true
  },
  "display": {
    "mode": "NO_X11_DEPENDENCY",
    "preferred": [
      "headless",
      "wayland"
    ],
    "xwaylandCompatibility": "SEPARATE_ISOLATED_GUEST_OPTION_AFTER_PROOF",
    "mayStartXorg": false,
    "mayConnectToDesktop": false,
    "maySetDisplayEnv": false,
    "mayModifyHostKernelOrGpu": false,
    "noPrivilegedDisplaySocketFromWeb": true,
    "westonHeadlessNotProven": true
  },
  "devices": {
    "usb": {
      "vendorId": "fourLowercaseHexDigits",
      "productId": "fourLowercaseHexDigits",
      "readOnlyByDefault": true,
      "realDeviceIdentityProven": false,
      "serialStorageForbidden": true,
      "driverDetachForbidden": true,
      "hotplugEnumerationRequiresOwnerApproval": true
    },
    "bluetooth": {
      "serviceUuid": "canonical128bitLowercase",
      "rawMacStorageForbidden": true,
      "writePairOrBondForbidden": true,
      "radioScanRequiresOwnerApproval": true,
      "privateAudioMicPermissionRequired": true,
      "androidRuntimePermissionProven": false
    },
    "debug": {
      "onlyRedactedStructuredEvent": true,
      "rawCommandExecution": false,
      "exposeKernelLogs": false,
      "traceExportRequiresOwnerReview": true,
      "neverInPublicMcp": true
    }
  },
  "modding": {
    "design": "ORIGINAL_GOTHIC_CHARACTER_ACTION_AND_GALAXY_DATA_SIM_INTERPRETATION_NOT_SOURCE_COPY",
    "inspiration": [
      "layeredCostumeCharacterCreation",
      "tacticalEncounterAndAnimationStates",
      "factionAndEconomyDataDrivenRules"
    ],
    "noThirdPartyCharacterOrMusicOrLoreRedistribution": true,
    "assetCategories": [
      "originalSvg",
      "originalBlend",
      "reviewedGlb",
      "shaderPreset",
      "modMetadata",
      "syntheticPatchManifest"
    ],
    "noArchiveExtractionByRegistry": true,
    "noRemoteBinaryFetch": true,
    "noAutoFork": true,
    "noAutoPluginInstall": true,
    "noGameExecutableInjection": true,
    "noCheatInOnlineAnticheat": true,
    "noCopyNexusAssetsToDistribution": true,
    "noDirectSqlExternalPluginAccess": true,
    "noBlenderOrGimpScriptsFromUntrustedMods": true,
    "noRightsProofFromGitHubStarCount": true,
    "noAbandonwareCopyrightException": true,
    "noRomBiosOrDiscImagesInSourceOrReceipts": true,
    "patchTypes": [
      "IPS",
      "BPS",
      "PPF"
    ],
    "patchMode": "METADATA_ONLY_FOR_HOME_BREW_OR_RIGHTS_PROVEN_USER_SUPPLIED_TITLE",
    "byteHexRole": "DETERMINISTIC_OFFSETS_AND_SHA256_NOT_LICENSE_OR_CRYPTO_SIGNATURE",
    "patchContentCannotBeFetchedOrAppliedByRegistry": true
  },
  "licensing": {
    "actualRoot": "GPL-3.0",
    "targetIndependentOwnedModules": "Apache-2.0_REVIEW_ONLY",
