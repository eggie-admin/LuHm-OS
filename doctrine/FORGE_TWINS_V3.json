      "sourceRef",
      "requestedBuildScope",
      "issuedAt",
      "expiresAt",
      "nonce",
      "singleUse"
    ],
    "castWord": "cast",
    "authorizedBy": "Professor",
    "defaultTtlMinutes": 30,
