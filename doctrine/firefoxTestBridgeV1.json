    "storedCredentialsInGitHub": false,
    "automaticPublication": false,
    "sourceChangesProposedOnly": true
  },
  "parentSource": "doctrine/firefoxAntennaV1.json",
  "product": "LuHm-OS: Project Premonition",
  "purpose": "Volatile opt-in personal forum-note demo with static HTML and Python3/SQLite, local TestBridge after Firefox antenna.",
  "network": {
    "bind": "127.0.0.1",
    "port": 8766,
    "httpsPublicExposure": false,
    "corsAllowOrigins": [],
