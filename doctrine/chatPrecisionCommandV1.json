{
  "schema": "luhmOs.chatPrecisionCommand.v1",
  "status": "SOURCE_CONFIGURED_CANDIDATE",
  "authority": "Professor",
  "purpose": "One deterministic command identity across Professor-facing icon/verb controls, HTML event ids, and code handlers.",
  "layers": {
    "icon": "single Professor-facing emoticon or compact glyph",
    "debugVerb": "DRAGONTAIL uppercase command token",
    "kebab": "lowercase kebab-case HTML DOM event route and transport identifier",
    "camelHump": "person-centered canonical code/API handler identifier",
    "compressedAliases": "optional vowel-ripped or lowercase shorthand aliases; help-recoverable only"
  },
  "requiredFields": [
    "icon",
    "debugVerb",
    "kebab",
    "camelHump",
    "scope",
    "mode",
    "authority",
    "evidenceRequired"
  ],
  "examples": [
    {
      "icon": "⚙️",
      "debugVerb": "DEBUG",
      "kebab": "debug-system",
      "camelHump": "debugSystem",
      "humanMeaning": "inspect and explain current system state"
    },
    {
      "icon": "👹",
      "debugVerb": "ROUTE",
      "kebab": "route-task",
      "camelHump": "routeTask",
      "humanMeaning": "route the current task to the smallest bounded agent lane"
    },
    {
      "icon": "🔨",
      "debugVerb": "BUILD",
      "kebab": "build-candidate",
      "camelHump": "buildCandidate",
      "humanMeaning": "build the current candidate through the permitted forge lane"
    },
    {
      "icon": "🕯️",
      "debugVerb": "PROVE",
      "kebab": "prove-state",
      "camelHump": "proveState",
      "humanMeaning": "verify a state using evidence"
    },
    {
      "icon": "📚",
      "debugVerb": "STATE",
      "kebab": "show-checkpoint",
      "camelHump": "showCheckpoint",
      "humanMeaning": "show the current checkpoint and workflow state"
    },
    {
      "icon": "🎀",
      "debugVerb": "PLAY",
      "kebab": "open-world",
      "camelHump": "openWorld",
      "humanMeaning": "open the interactive world or cockpit experience"
    },
    {
      "icon": "🔍",
      "debugVerb": "DIVE",
      "kebab": "deep-dungeon",
      "camelHump": "deepDungeon",
