  "normalizationLaw": {
    "allLayersRepresentSameCommand": true,
    "displayAliasMayCreateNewAuthority": false,
    "unknownCommand": "VERIFY",
    "naturalLanguageMayResolveToKnownCommandOnlyWhenScopeAndAuthorityRemainBounded": true,
    "compressedAliasMustResolveThroughHelp": true,
    "canonicalHumanMeaningMustRemainAvailable": true
  },
  "authorityBoundary": {
    "schemaMayGrantMutationAuthority": false,
    "schemaMayGrantGreen": false,
    "schemaMayGrantCrown": false,
    "consequentialCommandStillRequiresExistingLuHmAuthorityGate": true
  },
  "crownStatus": "STOP",
  "namingContract": "doctrine/namingNamespaceCanonV1.json",
  "helpContract": "doctrine/commandHelpV1.json"
}
