{
  "schema": "luhmOs.chatPrecisionCommand.v1",
  "status": "SOURCE_CONFIGURED_CANDIDATE",
  "authority": "Professor",
  "purpose": "One deterministic command identity across Professor-facing icon/verb controls, HTML event ids, and code handlers.",
  "layers": {
    "icon": "single Professor-facing emoticon or compact glyph",
    "debugVerb": "UPPERCASE function family token",
    "kebab": "HTML DOM, event, route, and transport identifier",
    "camelHump": "code/API handler identifier"
  },
  "requiredFields": ["icon","debugVerb","kebab","camelHump","scope","mode","authority","evidenceRequired"],
  "examples": [
    {"icon":"⚙️","debugVerb":"DEBUG","kebab":"debug-system","camelHump":"debugSystem"},
    {"icon":"👹","debugVerb":"ROUTE","kebab":"route-task","camelHump":"routeTask"},
    {"icon":"🔨","debugVerb":"BUILD","kebab":"build-candidate","camelHump":"buildCandidate"},
    {"icon":"🕯️","debugVerb":"PROVE","kebab":"prove-state","camelHump":"proveState"},
    {"icon":"📚","debugVerb":"STATE","kebab":"show-checkpoint","camelHump":"showCheckpoint"},
    {"icon":"🎀","debugVerb":"PLAY","kebab":"open-world","camelHump":"openWorld"},
    {"icon":"🔍","debugVerb":"DIVE","kebab":"deep-dungeon","camelHump":"deepDungeon"},
    {"icon":"▶️","debugVerb":"CONTINUE","kebab":"continue-fast-path","camelHump":"continueFastPath"}
  ],
  "normalizationLaw": {
    "allLayersRepresentSameCommand": true,
    "displayAliasMayCreateNewAuthority": false,
    "unknownCommand": "VERIFY",
    "naturalLanguageMayResolveToKnownCommandOnlyWhenScopeAndAuthorityRemainBounded": true
