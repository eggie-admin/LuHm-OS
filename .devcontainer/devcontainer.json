{
  "name": "LuHm OS Workshop",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "remoteUser": "codespace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-json",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "python --version && node --version && git --version",
  "containerEnv": {
    "LUHM_WORKBENCH": "codespaces",
    "LUHM_CROWN_STATUS": "STOP"
  }
}
