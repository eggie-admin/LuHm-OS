{
  "name": "LuHm OS | Professor Ubuntu 26.04 LTS Basement",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "codespace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-json",
        "eamodio.gitlens"
      ]
    }
  },
  "containerEnv": {
    "LUHM_WORKBENCH": "codespaces",
    "LUHM_CROWN_STATUS": "STOP",
    "LUHM_GARAGE_RUNTIME": "github-codespaces",
    "LUHM_FFMPEG_PUBLICATION": "STOP",
    "LUHM_PRIVATE_SERVICES": "MANUAL_ONLY"
  },
  "postCreateCommand": "bash scripts/ai-ffmpeg-codespaces.sh setup && bash scripts/professorGarageSmoke.sh",
  "postStartCommand": "bash scripts/ai-ffmpeg-codespaces.sh start",
  "forwardPorts": [
    8797
  ],
  "portsAttributes": {
    "8797": {
      "label": "AI-FFmpeg private garage worker",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  }
}
