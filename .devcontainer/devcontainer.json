{
  "name": "LuHm OS | Professor Garage Lab",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "remoteUser": "codespace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.vscode-json",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "bash scripts/ai-ffmpeg-codespaces.sh setup && python --version && node --version && git --version",
  "containerEnv": {
    "LUHM_WORKBENCH": "codespaces",
    "LUHM_CROWN_STATUS": "STOP",
    "LUHM_GARAGE_RUNTIME": "github-codespaces",
    "LUHM_FFMPEG_PUBLICATION": "STOP"
  },
  "postStartCommand": "bash scripts/ai-ffmpeg-codespaces.sh start",
  "forwardPorts": [
    8797
  ],
  "portsAttributes": {
    "8797": {
      "label": "AI-FFmpeg private garage worker",
      "onAutoForward": "silent"
    }
  }
}
