{
  "schema": "luhm-os.library-policy.v2",
  "productionPolicy": "vendored-or-self-hosted-only",
  "chatWidgetExternalCdnAllowed": false,
  "developmentCdnMode": "explicit-opt-in-only",
  "allowedDevelopmentOrigins": [],
  "libraries": [
    {
      "name": "Native Asset Desk",
      "purpose": "local file tree, preview, media carousel, PDF iframe, drag/drop",
      "load": "bundled"
    },
    {
      "name": "Native Parallax",
      "purpose": "requestAnimationFrame pointer depth effect",
      "load": "bundled"
    },
    {
      "name": "jQuery",
      "purpose": "pinned same-origin cockpit compatibility",
      "load": "bundled",
      "version": "3.7.1"
    },
    {
      "name": "jQuery UI",
      "purpose": "pinned same-origin cockpit compatibility",
      "load": "bundled",
      "version": "1.14.2"
    },
    {
      "name": "Vue 3",
      "purpose": "larger CMS stateful views",
      "load": "not-bundled-by-default"
    }
  ],
  "donorRule": "Donors inform behavior; code is copied only when license/provenance is explicit and the dependency fits current doctrine.",
  "rules": [
    "No third-party CDN JavaScript in production or the ChatGPT widget.",
    "No ad, analytics, remote-image, YouTube, or arbitrary upload endpoints from donor demos.",
    "Local file intake uses browser File/Blob APIs only and never grants server write authority.",
    "Unknown or absent donor licenses are concept-only and are not copied.",
    "Production dependencies must be vendored/self-hosted and pinned before activation."
  ],
  "embeddedMedia": {
    "provider": "youtube",
    "frameOrigin": "https://www.youtube-nocookie.com",
    "load": "userInitiatedOnly",
    "autoplay": false,
    "remoteScriptInParent": false,
    "nativeYouTubeMusicAppEmbed": false
  },
  "selfHostedRemoteUpdatePolicy": {
    "contract": "doctrine/selfHostedRemoteUpdatesV1.json",
    "updateManifest": "/harness/updates/v2/manifest.json",
    "contentHashedAssets": true,
    "CDNActive": false,
    "fontCss": "/harness/assets/fontStack.css",
    "fontsFallbackOnly": true,
    "svgOriginal": "/harness/assets/luhmSigil.svg",
    "runtimeThirdPartyCdnScripts": false,
    "remoteScriptsExecutedFromManifest": false,
    "versionUpdateByApprovedHostDeployOnly": true,
    "automaticApkInstall": false
  }
}
