# EXAMPLE ONLY. This file must stay PRIVATE on the authorized host.
# Place at ~/.config/luhm/canon-sync.env with chmod 600.
# Never put Google OAuth tokens or SSH private keys in GitHub.
LUHM_SYNC_ARMED=NO
LUHM_INGRESS_DIR=%h/LuHmInbox
LUHM_STAGING_DIR=%h/LuHmState/staging
LUHM_STATE_DIR=%h/LuHmState/state
LUHM_RCLONE_DEST=luhm-drive:LuHm-OS-Private/CanonIngress
# Optional SSH rsync pull. Pin the host key outside this file.
# LUHM_RSYNC_SOURCE=syncuser@trusted-host.example:/srv/luhm/exports/
