# EXAMPLE ONLY. Keep your own copy PRIVATE on the authorized Ubuntu host.
# Replace YOUR_USER with the private host login and chmod 600 the installed copy.
# Google OAuth tokens and SSH private keys live outside GitHub.
LUHM_SYNC_ARMED=NO
LUHM_INGRESS_DIR=/home/YOUR_USER/LuHmInbox
LUHM_STAGING_DIR=/home/YOUR_USER/LuHmState/staging
LUHM_STATE_DIR=/home/YOUR_USER/LuHmState/state
LUHM_RCLONE_DEST=luhm-drive:LuHm-OS-Private/CanonIngress
# Optional SSH rsync pull. Pin host key outside this file.
# LUHM_RSYNC_SOURCE=syncuser@trusted-host.example:/srv/luhm/exports/
